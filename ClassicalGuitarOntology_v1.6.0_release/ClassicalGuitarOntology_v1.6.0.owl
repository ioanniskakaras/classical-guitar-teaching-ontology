    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_1_4_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη του συντονισμού του χεριού στην πλευρά του σώματος της κιθάρας κατά την εκτέλεση συγχορδιών και αρπισμών σε μη γειτονικές χορδές.</Literal>
