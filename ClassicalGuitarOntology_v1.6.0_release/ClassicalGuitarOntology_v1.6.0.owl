    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_1_4_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης αρπισμών με ταυτόχρονη κρούση και σαφή δυναμική έμφαση στον αντίχειρα, με διατήρηση της ακρίβειας, της ομοιογένειας και της χαλαρότητας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
