    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#ReadingAndSightReadingSkill</IRI>
        <Literal xml:lang="el">Δεξιότητα ανάγνωσης και εκ πρώτης όψεως ανάγνωσης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RenaissanceGuitar</IRI>
        <Literal xml:lang="el">Ιστορικός τύπος κιθάρας της Αναγέννησης, ο οποίος παρουσιάζεται στο Πρόγραμμα Σπουδών στο πλαίσιο της ιστορικής εξέλιξης του οργάνου και της μελέτης των συγγενών οργάνων εποχής και εξετάζεται ως προς τα βασικά χαρακτηριστικά του.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#RenaissanceGuitar</IRI>
        <Literal xml:lang="en">Renaissance Guitar</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#RenaissanceGuitar</IRI>
        <Literal xml:lang="el">Αναγεννησιακή κιθάρα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RenaissancePeriod</IRI>
        <Literal xml:lang="el">Περίοδος από τον 15ο έως τον 17ο αιώνα, όπου αναπτύχθηκε η πολυφωνία και η εκκλησιαστική μουσική.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#RenaissancePeriod</IRI>
        <Literal xml:lang="en">Renaissance Period</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#RenaissancePeriod</IRI>
        <Literal xml:lang="el">Περίοδος της Αναγέννησης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Repertoire</IRI>
        <Literal xml:lang="el">Αναπαριστά μουσικό έργο ή κομμάτι που εντάσσεται στο διδακτικό και εκτελεστικό ρεπερτόριο της κλασικής κιθάρας και μπορεί να συνδέεται με συγκεκριμένη ιστορική περίοδο, κατηγορία και επίπεδο σπουδών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Repertoire</IRI>
        <Literal xml:lang="en">Repertoire</Literal>
