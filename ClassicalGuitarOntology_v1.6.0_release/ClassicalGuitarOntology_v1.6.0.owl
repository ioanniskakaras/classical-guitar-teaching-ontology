        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Technique_NeckSideFingerCombinationCoordination</IRI>
        <Literal xml:lang="el">Τεχνική συντονισμού των συνδυασμών δαχτύλων του χεριού στην πλευρά του λαιμού της κιθάρας</Literal>
