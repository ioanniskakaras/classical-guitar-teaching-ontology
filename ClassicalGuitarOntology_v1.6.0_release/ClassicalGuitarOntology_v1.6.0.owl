    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_4_1_5_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης τριπλών ανιόντων και κατιόντων δεμένων φθόγγων και μικτών δεμένων φθόγγων, με έμφαση στην καθαρότητα, την ισορροπία της έντασης και τη ρυθμική ακρίβεια.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_4_1_5_1</IRI>
        <Literal xml:lang="en">Objective 4.1.5.1 – Triple Ascending and Descending Slurs, and Mixed Slurs</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
