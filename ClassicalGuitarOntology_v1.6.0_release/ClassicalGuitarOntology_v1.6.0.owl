    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HumanBodyPart</IRI>
        <Literal xml:lang="el">Αναπαριστά μέρος του ανθρώπινου σώματος που σχετίζεται με τη στάση, τη στήριξη του οργάνου ή την εκτέλεση τεχνικών της κλασικής κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
