        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_5</IRI>
        <Literal xml:lang="el">Στόχος 6.5 – Εκτέλεση μουσικής για κιθάρα σε συναυλίες και πρακτικές σκηνικής παρουσίας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_6</IRI>
        <Literal xml:lang="el">Ανάπτυξη θετικής συναισθηματικής εμπλοκής και δημιουργικής μουσικότητας μέσω του αυτοσχεδιασμού και της σύνθεσης.</Literal>
    </AnnotationAssertion>
