    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_AlternatingFingerStringChange</IRI>
        <Literal xml:lang="el">Δεξιότητα αλλαγής χορδής με διατήρηση της εναλλαγής των δαχτύλων, χωρίς διαδοχική χρήση του ίδιου δαχτύλου.</Literal>
