    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_1_5_3</IRI>
        <Literal xml:lang="el">Στόχος 5.1.5.3 – Διπλοί ανιόντες δεμένοι φθόγγοι</Literal>
