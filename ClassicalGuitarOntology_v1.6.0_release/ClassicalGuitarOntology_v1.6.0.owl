        <Literal xml:lang="en">Objective 2.1.3 – Two-Octave Major and Melodic-Minor Scales and Chord Arpeggios</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_2_1_3</IRI>
        <Literal xml:lang="el">Στόχος 2.1.3 – Μείζονες και ελάσσονες κλίμακες και αρπέζ σε 2 οκτάβες</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_2_1_4</IRI>
        <Literal xml:lang="el">Ανάπτυξη της τεχνικής και της ευκινησίας του χεριού στην πλευρά του σώματος της κιθάρας μέσω αρπισμών με ποικίλους συνδυασμούς των δαχτύλων p, i, m και a, με έμφαση στον σταθερό ρυθμό, στους σωστούς τονισμούς και στη σταδιακή ανάπτυξη της ταχύτητας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
