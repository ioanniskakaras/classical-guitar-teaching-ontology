    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Level</IRI>
        <Literal xml:lang="el">Στάδιο εκπαίδευσης στην κλασική κιθάρα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Level</IRI>
