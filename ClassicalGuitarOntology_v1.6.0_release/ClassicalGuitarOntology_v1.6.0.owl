        <Literal xml:lang="en">Objective 4.1.5.2 – Double Appoggiatura</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_4_1_5_2</IRI>
        <Literal xml:lang="el">Στόχος 4.1.5.2 – Διπλή appoggiatura</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_4_1_5_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης της τεχνικής glissando σύμφωνα με τις απαιτήσεις του 4ου επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
