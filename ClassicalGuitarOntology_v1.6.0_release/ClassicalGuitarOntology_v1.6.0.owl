    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Crit_Level5_StudiesAndPieces</IRI>
        <Literal xml:lang="el">Κριτήριο 5ου Επιπέδου: Μελέτη και άρτια εκτέλεση σπουδών και έργων ρεπερτορίου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Crit_Level5_TechnicalExercises</IRI>
        <Literal xml:lang="el">Αξιολογεί την εκτέλεση των διδαχθεισών ασκήσεων τεχνικής του 5ου επιπέδου: κλίμακες σε δύο και τρεις οκτάβες, χρωματικές κλίμακες, κλίμακες σε τρίτες και οκτάβες, αρπέζ δύο οκτάβων, τετράφωνα ακόρντα μεθ’ εβδόμης, τεχνικές του χεριού στην πλευρά του σώματος και του ηχείου, καθώς και mordente, τρίλιες, διπλούς ανιόντες δεμένους φθόγγους και αλλαγές θέσεων έως την 9η θέση για το χέρι στην πλευρά του λαιμού.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Crit_Level5_TechnicalExercises</IRI>
        <Literal xml:lang="en">Criterion Level 5: Technical Exercises</Literal>
