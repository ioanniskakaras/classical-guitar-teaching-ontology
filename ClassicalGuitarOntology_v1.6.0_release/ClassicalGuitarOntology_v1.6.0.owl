<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="http://www.semanticweb.org/ioann/ontologies/2025/6/ClassicalGuitarTeachingMethodOntology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="http://www.semanticweb.org/ioann/ontologies/2025/6/ClassicalGuitarTeachingMethodOntology"
     versionIRI="http://www.semanticweb.org/ioann/ontologies/2025/6/ClassicalGuitarTeachingMethodOntology/1.6.0">
    <Prefix name="" IRI="http://www.semanticweb.org/ioann/ontologies/2025/6/ClassicalGuitarTeachingMethodOntology#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
