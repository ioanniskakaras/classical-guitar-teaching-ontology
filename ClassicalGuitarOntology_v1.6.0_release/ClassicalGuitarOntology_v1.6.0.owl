        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Exercise_Mixolydian_1</IRI>
        <Literal xml:lang="el">Μελωδική άσκηση στον μιξολύδιο τρόπο, η οποία χρησιμοποιείται για την ανάγνωση, αναγνώριση και εκτέλεση φυσικών φθόγγων της 1ης θέσης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Exercise_Mixolydian_1</IRI>
        <Literal xml:lang="en">Exercise - Mixolydian No. 1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
