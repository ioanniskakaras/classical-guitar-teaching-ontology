        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_3_1</IRI>
        <Literal xml:lang="el">Στόχος 5.3.1 – Συνοπτική γνώση της ιστορίας του ρεπερτορίου και των συνθετών του 20ού και 21ου αιώνα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
