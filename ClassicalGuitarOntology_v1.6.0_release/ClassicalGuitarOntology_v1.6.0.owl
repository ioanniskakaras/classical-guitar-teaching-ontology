    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_2_3_2</IRI>
        <Literal xml:lang="el">Στόχος 2.3.2 – Αισθητική καλλιέργεια</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_2_3_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας γνώσης και συνοπτικής παρουσίασης βασικών βιογραφικών στοιχείων των συνθετών των ασκήσεων, σπουδών και έργων που περιλαμβάνονται στη διδασκαλία του/της μαθητή/τριας, με σύνδεσή τους με την αντίστοιχη ιστορική περίοδο και το διδαγμένο μουσικό υλικό.</Literal>
    </AnnotationAssertion>
