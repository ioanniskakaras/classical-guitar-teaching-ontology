        <Literal xml:lang="en">Objective 4.4.1 – Fluent Sight-Reading of Easy Works at Level 2 Difficulty</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_4_4_1</IRI>
        <Literal xml:lang="el">Στόχος 4.4.1 – Άνεση στην εκ πρώτης όψεως ανάγνωση εύκολων έργων του 2ου επιπέδου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_4_4_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκ πρώτης όψεως ανάγνωσης και εκτέλεσης απλών μονοφωνικών μελωδιών στην 5η θέση, σε όλες τις χορδές, με απλές αλλοιώσεις και χρονικές αξίες έως και δέκατα έκτα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
