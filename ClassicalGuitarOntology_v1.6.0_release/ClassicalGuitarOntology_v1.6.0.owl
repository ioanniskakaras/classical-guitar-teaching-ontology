        <Literal xml:lang="el">Τεχνική ανεξαρτησίας και ελαστικότητας των δαχτύλων του χεριού στην πλευρά του λαιμού</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Technique_NinthPositionNoteReadingRecognitionAndExecution</IRI>
