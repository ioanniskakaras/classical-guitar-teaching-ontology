        <IRI>#LO_1_1_5</IRI>
        <Literal xml:lang="el">Στόχος 1.1.5 – Χρήση του αντίχειρα (p)</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_1_1_6</IRI>
