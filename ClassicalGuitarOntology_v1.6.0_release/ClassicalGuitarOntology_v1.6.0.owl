        <IRI>#Skill_GreekGuitarComposersPerformersAndLuthiersKnowledge</IRI>
        <Literal xml:lang="el">Γνώση Ελλήνων συνθετών, ερμηνευτών και κατασκευαστών κιθάρας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuidedAestheticListeningToClassicalRomanticWorks</IRI>
        <Literal xml:lang="el">Δεξιότητα καθοδηγούμενης ακρόασης και αισθητικής προσέγγισης χαρακτηριστικών έργων του Κλασικισμού και του Ρομαντισμού, με στόχο την αναγνώριση και κατανόηση βασικών υφολογικών χαρακτηριστικών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
