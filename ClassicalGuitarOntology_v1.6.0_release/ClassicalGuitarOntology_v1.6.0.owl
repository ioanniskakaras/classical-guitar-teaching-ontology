    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ScaleTheoryCorrelationAndRelativeKeySequencing</IRI>
        <Literal xml:lang="el">Δεξιότητα συσχέτισης της πρακτικής των κλιμάκων με τα θεωρητικά μαθήματα και εκτέλεσής τους ως συνεχούς ακολουθίας σχετικών μείζονων και ελάσσονων τονικοτήτων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
