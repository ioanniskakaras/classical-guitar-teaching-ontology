        <IRI>#Exercise_Mixolydian_1</IRI>
        <Literal xml:lang="el">Άσκηση στον μιξολύδιο τρόπο αρ. 1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Exercise_OpenStringFingerAlternation</IRI>
        <Literal xml:lang="el">Άσκηση σε ανοικτές χορδές με απλά ρυθμικά σχήματα, στους συνδυασμούς i–m, m–a και i–a, σε όλες τις χορδές και με ζυγό ή μονό αριθμό φθόγγων, ώστε η αλλαγή χορδής να πραγματοποιείται χωρίς διαδοχική χρήση του ίδιου δαχτύλου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Exercise_OpenStringFingerAlternation</IRI>
        <Literal xml:lang="en">Open-String Finger-Alternation Exercise</Literal>
    </AnnotationAssertion>
