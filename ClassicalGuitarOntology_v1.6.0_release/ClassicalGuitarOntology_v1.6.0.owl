        <Literal xml:lang="el">Κατηγορία διαθεματικότητας – 5ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#InterdisciplinarityObjectiveCategory</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων που αφορά τη διαθεματική προσέγγιση της κλασικής κιθάρας μέσω της σύνδεσής της με άλλα γνωστικά, ιστορικά και καλλιτεχνικά πεδία.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
