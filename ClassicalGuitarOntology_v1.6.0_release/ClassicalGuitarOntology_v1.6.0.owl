    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_AccurateNeckSideFingerPlacement</IRI>
        <Literal xml:lang="el">Ακριβής τοποθέτηση των δαχτύλων στην ταστιέρα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_AccurateScoreRealizationInSightReading</IRI>
        <Literal xml:lang="el">Δεξιότητα ακριβούς απόδοσης των φθόγγων, των χρονικών αξιών, του μέτρου και των βασικών σημείων της παρτιτούρας κατά την εκ πρώτης όψεως ανάγνωση και εκτέλεση άγνωστου μουσικού κειμένου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
