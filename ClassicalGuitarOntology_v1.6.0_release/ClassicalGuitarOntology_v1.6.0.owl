        <IRI>#Skill_AccurateScoreRealizationInSightReading</IRI>
        <Literal xml:lang="el">Ακριβής απόδοση της παρτιτούρας στην εκ πρώτης όψεως ανάγνωση</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_AccurateStringAttack</IRI>
        <Literal xml:lang="el">Δεξιότητα ακριβούς στόχευσης και κρούσης των προβλεπόμενων χορδών κατά την εκτέλεση τεχνικών ασκήσεων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
