    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Crit_Level1_AnnualCommitteeSelectedWork</IRI>
        <Literal xml:lang="el">Αξιολογεί την εκτέλεση μίας σπουδής ή ενός έργου ρεπερτορίου από την εξεταστέα ύλη, το οποίο επιλέγει η εξεταστική επιτροπή, χωρίς ιδιαίτερες απαιτήσεις ως προς την ακρίβεια του tempo ή την απουσία λαθών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Crit_Level1_AnnualCommitteeSelectedWork</IRI>
        <Literal xml:lang="en">Level 1 Annual Examination Criterion: Examination-Committee-Selected Work</Literal>
    </AnnotationAssertion>
