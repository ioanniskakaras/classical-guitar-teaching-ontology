    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuidedAestheticListeningToClassicalRomanticWorks</IRI>
        <Literal xml:lang="el">Καθοδηγούμενη αισθητική ακρόαση έργων του Κλασικισμού και του Ρομαντισμού</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuidedAestheticListeningToHistoricalInstrumentSounds</IRI>
        <Literal xml:lang="el">Δεξιότητα προσεκτικής και καθοδηγούμενης ακρόασης ενδεικτικών ηχητικών παραδειγμάτων ιστορικών οργάνων, με σκοπό την εξοικείωση με τον ιδιαίτερο ηχητικό χαρακτήρα τους και τη σύνδεση της ακροαματικής εμπειρίας με την ιστορική γνώση του οργάνου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_GuidedAestheticListeningToHistoricalInstrumentSounds</IRI>
        <Literal xml:lang="en">Guided Aesthetic Listening to Historical Instrument Sounds</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuidedAestheticListeningToHistoricalInstrumentSounds</IRI>
        <Literal xml:lang="el">Καθοδηγούμενη αισθητική ακρόαση του ήχου ιστορικών οργάνων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuidedAestheticListeningToRenaissanceBaroqueWorks</IRI>
        <Literal xml:lang="el">Δεξιότητα προσεκτικής και καθοδηγούμενης ακρόασης χαρακτηριστικών έργων της Αναγέννησης και του Μπαρόκ, με σκοπό την αναγνώριση βασικών μουσικών, αισθητικών και υφολογικών χαρακτηριστικών και τη σύνδεση της ακροαματικής εμπειρίας με τη διάκριση των δύο ιστορικών περιόδων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_GuidedAestheticListeningToRenaissanceBaroqueWorks</IRI>
        <Literal xml:lang="en">Guided Aesthetic Listening to Renaissance and Baroque Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuidedAestheticListeningToRenaissanceBaroqueWorks</IRI>
        <Literal xml:lang="el">Καθοδηγούμενη αισθητική ακρόαση έργων της Αναγέννησης και του Μπαρόκ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuidedImprovisationWithGivenMaterialOverSimpleHarmonicProgression</IRI>
        <Literal xml:lang="el">Δεξιότητα συνδυαστικής και αυτοσχεδιαστικής αξιοποίησης δοσμένου μελωδικού και ρυθμικού υλικού πάνω σε απλή ρυθμική και αρμονική ακολουθία 4 ή 8 μέτρων, με βασική μουσική συνοχή και δυνατότητα αξιοποίησης αρμονικής πρότασης που ανταποκρίνεται στις μουσικές προτιμήσεις του/της μαθητή/τριας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_GuidedImprovisationWithGivenMaterialOverSimpleHarmonicProgression</IRI>
        <Literal xml:lang="en">Guided Improvisation with Given Material over a Simple Harmonic Progression</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuidedImprovisationWithGivenMaterialOverSimpleHarmonicProgression</IRI>
        <Literal xml:lang="el">Καθοδηγούμενος αυτοσχεδιασμός με δοσμένο υλικό πάνω σε απλή αρμονική ακολουθία</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuidedInterpretiveListening</IRI>
        <Literal xml:lang="el">Δεξιότητα προσεκτικής ακρόασης ηχογραφήσεων και παρακολούθησης βίντεο διακεκριμένων σολίστ στα έργα που ερμηνεύει ο/η μαθητής/τρια και σε άλλα έργα που προτείνει ο/η καθηγητής/τρια, με εντοπισμό βασικών ερμηνευτικών επιλογών και χαρακτηριστικών της ποιότητας του ήχου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_GuidedInterpretiveListening</IRI>
        <Literal xml:lang="en">Guided Listening to Performances by Distinguished Soloists</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuidedInterpretiveListening</IRI>
        <Literal xml:lang="el">Καθοδηγούμενη ακρόαση ερμηνειών διακεκριμένων σολίστ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuidedPerformanceSelfEvaluation</IRI>
        <Literal xml:lang="el">Δεξιότητα καθοδηγούμενης αναστοχαστικής αποτίμησης ζωντανής ή ηχογραφημένης εκτέλεσης, με εντοπισμό βασικών προβλημάτων και σχολιασμό της άρθρωσης, του ήχου, της ισορροπίας ή της σκηνικής παρουσίας, ανάλογα με το πλαίσιο, σε συνεργασία με τον/την καθηγητή/τρια.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_GuidedPerformanceSelfEvaluation</IRI>
        <Literal xml:lang="en">Guided Performance Self-Evaluation</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuidedPerformanceSelfEvaluation</IRI>
        <Literal xml:lang="el">Καθοδηγούμενη αυτοαξιολόγηση της εκτέλεσης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuitarAncestorRecognitionAndCharacteristicKnowledge</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης και βασικής διάκρισης ιστορικών προγόνων της κιθάρας, όπως η βιχουέλα, το λαούτο, η αναγεννησιακή κιθάρα, η μπαρόκ κιθάρα και η θεόρβη, καθώς και συνοπτικής αναφοράς στα κύρια χαρακτηριστικά τους.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_GuitarAncestorRecognitionAndCharacteristicKnowledge</IRI>
        <Literal xml:lang="en">Recognition of Guitar Ancestors and Their Basic Characteristics</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_GuitarAncestorRecognitionAndCharacteristicKnowledge</IRI>
        <Literal xml:lang="el">Αναγνώριση των προγόνων της κιθάρας και των βασικών χαρακτηριστικών τους</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_GuitarFriendlyKeyTransposition</IRI>
        <Literal xml:lang="el">Ικανότητα μεταφοράς μουσικού υλικού σε τονικότητα που διευκολύνει την εκτέλεσή του στην κλασική κιθάρα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
