        <Literal xml:lang="el">Στόχος 6.6 – Θετικά συναισθήματα μέσω αυτοσχεδιασμού και σύνθεσης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LearningObjective</IRI>
        <Literal xml:lang="el">Αναπαριστά συγκεκριμένο μαθησιακό αποτέλεσμα που επιδιώκεται σε ορισμένο επίπεδο σπουδών και εντάσσεται σε κατηγορία μαθησιακών στόχων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LearningObjective</IRI>
        <Literal xml:lang="en">Learning Objective</Literal>
