        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RasgueadoEvenIntensityAndRhythm</IRI>
        <Literal xml:lang="el">Ομοιογενής ένταση και ρυθμός στο rasgueado</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RehearsalAndEnsembleParticipation</IRI>
        <Literal xml:lang="el">Δεξιότητα συνεπούς συμμετοχής στις πρόβες και στις δραστηριότητες μουσικών συνόλων, με προετοιμασία του προσωπικού μέρους, συνεργασία με τους υπόλοιπους μουσικούς και ανταπόκριση στις οδηγίες του/της διδάσκοντα/ουσας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
