        <IRI>#Skill_ShortMelodyPlaybackByEar</IRI>
        <Literal xml:lang="el">Αναπαραγωγή εξ ακοής σύντομης απλής μελωδίας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_SimpleAppoggiaturaExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα καθαρής, ισορροπημένης και ρυθμικά ακριβούς εκτέλεσης απλής appoggiatura.</Literal>
