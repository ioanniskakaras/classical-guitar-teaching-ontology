    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Thumb</IRI>
        <Literal xml:lang="el">Αναπαριστά τον αντίχειρα του χεριού που λειτουργεί στην πλευρά του σώματος και του ηχείου της κιθάρας και δηλώνεται στην κιθαριστική δακτυλοθεσία με το γράμμα p.</Literal>
    </AnnotationAssertion>
