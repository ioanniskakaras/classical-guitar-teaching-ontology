    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#IndexFinger</IRI>
        <Literal xml:lang="el">Αναπαριστά τον δείκτη του χεριού που λειτουργεί στην πλευρά του σώματος και του ηχείου της κιθάρας και δηλώνεται στην κιθαριστική δακτυλοθεσία με το γράμμα i.</Literal>
    </AnnotationAssertion>
