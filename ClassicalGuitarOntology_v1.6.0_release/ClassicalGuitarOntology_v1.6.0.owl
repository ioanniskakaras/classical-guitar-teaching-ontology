    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Crit_Level1_AnnualStudyPerformance</IRI>
        <Literal xml:lang="el">Αξιολογεί την εκτέλεση μίας σπουδής από τη διδαχθείσα ύλη του 1ου επιπέδου στο πλαίσιο της ετήσιας εξέτασης ακρόασης.</Literal>
    </AnnotationAssertion>
