        <IRI>#LO_5_1_3</IRI>
        <Literal xml:lang="el">Στόχος 5.1.3 – Τετράφωνα ακόρντα μεθ’ εβδόμης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_1_4</IRI>
        <Literal xml:lang="el">Γενικός μαθησιακός στόχος του 5ου επιπέδου που αφορά την περαιτέρω ανάπτυξη της τεχνικής και της ευκινησίας του χεριού στην πλευρά του σώματος της κιθάρας.</Literal>
    </AnnotationAssertion>
