        <IRI>#Crit_Level1_AnnualStudyPerformance</IRI>
        <Literal xml:lang="el">Κριτήριο ετήσιας εξέτασης 1ου επιπέδου: Εκτέλεση μίας σπουδής</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Crit_Level1_ApplicationInStudies</IRI>
        <Literal xml:lang="el">Αξιολογεί την ικανοποιητική εφαρμογή των διδαχθεισών κλιμάκων, αρπέζ, συγχορδιών και τεχνικών του χεριού στην πλευρά του λαιμού της κιθάρας στις σπουδές και στο ρεπερτόριο του 1ου επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
