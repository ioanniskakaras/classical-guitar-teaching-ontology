        <Literal xml:lang="el">Ένας συνδυασμός δαχτύλων του χεριού στην πλευρά του σώματος της κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
