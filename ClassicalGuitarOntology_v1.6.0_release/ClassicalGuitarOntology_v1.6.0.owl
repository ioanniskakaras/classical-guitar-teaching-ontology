    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingCategory_Level1</IRI>
        <Literal xml:lang="en">Sight-Reading Category – Level 1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingCategory_Level1</IRI>
        <Literal xml:lang="el">Κατηγορία εκ πρώτης όψεως ανάγνωσης – 1ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SightReadingCategory_Level2</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 2ου επιπέδου που αφορά την εκ πρώτης όψεως ανάγνωση άγνωστων μονοφωνικών μουσικών κειμένων στην 1η θέση, ανάλογης δυσκολίας με τα εύκολα μονοφωνικά έργα του 1ου επιπέδου, καθώς και την αναπαραγωγή σύντομων απλών μελωδιών εξ ακοής (playback).</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingCategory_Level2</IRI>
        <Literal xml:lang="en">Sight-Reading Category – Level 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingCategory_Level2</IRI>
        <Literal xml:lang="el">Κατηγορία εκ πρώτης όψεως ανάγνωσης – 2ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SightReadingCategory_Level3</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 3ου επιπέδου που αφορά την ανάπτυξη άνεσης, αποτελεσματικότητας και ακρίβειας στην εκ πρώτης όψεως ανάγνωση άγνωστων μουσικών κειμένων δυσκολίας 1ου επιπέδου, καθώς και μονοφωνικών μελωδιών στη 2η θέση με απλές αλλοιώσεις.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingCategory_Level3</IRI>
        <Literal xml:lang="en">Sight-Reading Category – Level 3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingCategory_Level3</IRI>
        <Literal xml:lang="el">Κατηγορία εκ πρώτης όψεως ανάγνωσης – 3ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SightReadingCategory_Level4</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 4ου επιπέδου που αφορά την ανάπτυξη άνεσης και ακρίβειας στην εκ πρώτης όψεως ανάγνωση άγνωστων μουσικών κειμένων και την εκτέλεση μονοφωνικών μελωδιών στην 5η θέση.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingCategory_Level4</IRI>
        <Literal xml:lang="en">Sight-Reading Category – Level 4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingCategory_Level4</IRI>
        <Literal xml:lang="el">Κατηγορία εκ πρώτης όψεως ανάγνωσης – 4ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SightReadingCategory_Level5</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 5ου επιπέδου που αφορά την εκ πρώτης όψεως ανάγνωση άγνωστων τονικών μουσικών κειμένων στην 7η θέση, τις εναλλαγές μεταξύ 1ης και 2ης θέσης με χρήση μπάσων, συγχορδιών και απλών δεμένων φθόγγων, την εφαρμογή βασικών όρων δυναμικής και tempo και την ανάγνωση έργων δυσκολίας του 2ου επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingCategory_Level5</IRI>
        <Literal xml:lang="en">Sight-Reading Category – Level 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingCategory_Level5</IRI>
        <Literal xml:lang="el">Κατηγορία εκ πρώτης όψεως ανάγνωσης – 5ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SightReadingCategory_Level6</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 6ου επιπέδου που αφορά την εκ πρώτης όψεως ανάγνωση άγνωστων τονικών μουσικών κειμένων στην 9η θέση, τις εναλλαγές μεταξύ 1ης και 5ης θέσης με μπάσα, συγχορδίες, αλλοιωμένους φθόγγους και βασικούς όρους δυναμικής και tempo, καθώς και την ανάγνωση αδίδακτων εύκολων έργων δυσκολίας 3ου επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingCategory_Level6</IRI>
        <Literal xml:lang="en">Sight-Reading Category – Level 6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingCategory_Level6</IRI>
        <Literal xml:lang="el">Κατηγορία εκ πρώτης όψεως ανάγνωσης – 6ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#SightReadingObjectiveCategory</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων που αφορά την αναγνώριση και εκτέλεση άγνωστου μουσικού κειμένου στην κιθάρα, με έμφαση στη ρυθμική, τη μελωδική και την εκ πρώτης όψεως ανάγνωση.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#SightReadingObjectiveCategory</IRI>
        <Literal xml:lang="en">Sight Reading Objective Category</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#SightReadingObjectiveCategory</IRI>
        <Literal xml:lang="el">Κατηγορία Στόχου Εκ Πρώτης Όψεως Ανάγνωσης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill</IRI>
        <Literal xml:lang="el">Δεξιότητα ή ικανότητα που αναπτύσσει ο μαθητής ως αποτέλεσμα μαθησιακών στόχων, διδακτικών πρακτικών και αξιολόγησης στο πλαίσιο της διδασκαλίας της κλασικής κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill</IRI>
        <Literal xml:lang="en">Skill</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill</IRI>
        <Literal xml:lang="el">Δεξιότητα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_AccurateDynamicAndArticulationSymbolApplicationInStudies</IRI>
        <Literal xml:lang="el">Δεξιότητα ακριβούς αναγνώρισης και απόδοσης των μουσικών συμβόλων δυναμικής, στίξης και άρθρωσης κατά την εκτέλεση σπουδών μικτής τεχνικής.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
