        <IRI>#Exercise_OpenStringFingerAlternation</IRI>
        <Literal xml:lang="el">Άσκηση εναλλαγής δαχτύλων σε ανοικτές χορδές</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Exercise_PalliniMethod_12</IRI>
        <Literal xml:lang="el">Άσκηση για την ταυτόχρονη εκτέλεση αρμονικών διαστημάτων και την προσθήκη μπάσου με τον αντίχειρα, όπως προβλέπεται στη διδακτική πρακτική 1.1.6.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
