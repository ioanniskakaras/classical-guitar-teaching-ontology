    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_3_4_2</IRI>
        <Literal xml:lang="en">Objective 3.4.2 – Sight-Reading Monophonic Melodies in Second Position with Simple Accidentals</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_3_4_2</IRI>
        <Literal xml:lang="el">Στόχος 3.4.2 – Εκ πρώτης όψεως ανάγνωση μονοφωνικών μελωδιών στη 2η θέση με απλές αλλοιώσεις</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_3_5</IRI>
        <Literal xml:lang="el">Περαιτέρω εξοικείωση του/της μαθητή/τριας με τη σκηνική παρουσία μέσω ενεργού συμμετοχής στις εκδηλώσεις και στις συναυλίες του σχολείου, εκτέλεσης μουσικής για κιθάρα ως σολίστ ή ως μέλους μουσικού συνόλου, συνεπούς συμμετοχής στις πρόβες και εφαρμογής των βασικών πρακτικών επιτυχημένης ζωντανής εμφάνισης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
