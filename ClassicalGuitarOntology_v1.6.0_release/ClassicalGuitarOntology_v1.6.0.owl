    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_2_2_2</IRI>
        <Literal xml:lang="el">Στόχος 2.2.2 – Ερμηνευτικοί όροι, εισαγωγή στη μουσική ερμηνεία και βελτίωση της ποιότητας του ήχου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_2_3_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της γνώσης της ιστορικής εξέλιξης της κιθάρας από την αρχαιότητα έως σήμερα, της αναγνώρισης των βασικών προγόνων και ιστορικών τύπων του οργάνου και της κατανόησης της διαμόρφωσης και της σύγχρονης κατασκευαστικής εξέλιξης της κλασικής κιθάρας.</Literal>
    </AnnotationAssertion>
