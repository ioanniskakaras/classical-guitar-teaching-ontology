    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Prefix name="skos" IRI="http://www.w3.org/2004/02/skos/core#"/>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/creator"/>
        <Literal xml:lang="en">Ioannis Kakaras</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="http://purl.org/dc/elements/1.1/creator"/>
        <Literal xml:lang="el">Ιωάννης Κακάρας</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="en">Classical Guitar Teaching Method Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="en">v1.6.0 – August 2026. Complete curriculum integration and validation release of the Classical Guitar Teaching Method Ontology. The ontology contains the completed and validated modelling of Curriculum Levels 1–6, following the annotation convention rdfs:label@en, skos:prefLabel@el, and rdfs:comment@el. Cross-level relations, minimum requirements, and annual examination assessment structures are included for the complete six-level curriculum. Logical consistency was verified with the HermiT reasoner. This release completes the planned representation of all six curriculum levels.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="el">v1.6.0 – Αύγουστος 2026. Έκδοση ολοκληρωμένης ενσωμάτωσης και επικύρωσης του Προγράμματος Σπουδών στην Οντολογία Μεθόδου Διδασκαλίας Κλασικής Κιθάρας. Η οντολογία περιλαμβάνει την ολοκληρωμένη και επικυρωμένη μοντελοποίηση των Επιπέδων Σπουδών 1–6, ακολουθώντας τη σύμβαση annotations rdfs:label@en, skos:prefLabel@el και rdfs:comment@el. Περιλαμβάνονται οι σχέσεις μεταξύ των επιπέδων, οι ελάχιστες απαιτήσεις και οι δομές αξιολόγησης των ετήσιων εξετάσεων για το σύνολο του προγράμματος των έξι επιπέδων. Η λογική συνέπεια επαληθεύτηκε με τον reasoner HermiT. Η παρούσα έκδοση ολοκληρώνει την προβλεπόμενη αναπαράσταση και των έξι επιπέδων σπουδών.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <Literal xml:lang="el">Οντολογία Μεθόδου Διδασκαλίας Κλασικής Κιθάρας</Literal>
    </Annotation>
