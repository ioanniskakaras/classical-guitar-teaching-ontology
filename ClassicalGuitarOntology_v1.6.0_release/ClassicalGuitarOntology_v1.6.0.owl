        <Literal xml:lang="el">Μέρη Ανθρώπινου Σώματος</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ImprovisationAndCreativityCategory_Level6</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 6ου επιπέδου που αφορά την άντληση θετικών συναισθημάτων μέσω του αυτοσχεδιασμού και της σύνθεσης, τη συνεργατική δημιουργία έργων μικρής διάρκειας σε μικρά περιστασιακά σύνολα και την αυτοαξιολόγηση του αποτελέσματος.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
