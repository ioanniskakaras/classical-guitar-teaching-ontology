        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_4_2</IRI>
        <Literal xml:lang="el">Στόχος 6.4.2 – Εναλλαγές 1ης και 5ης θέσης με μπάσα, συγχορδίες και αλλοιωμένους φθόγγους</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_4_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκ πρώτης όψεως ανάγνωσης και εκτέλεσης αδίδακτων εύκολων έργων που αντιστοιχούν στον βαθμό δυσκολίας του 3ου επιπέδου.</Literal>
    </AnnotationAssertion>
