        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_4_3</IRI>
        <Literal xml:lang="el">Στόχος 6.4.3 – Εκτέλεση εύκολων έργων του ρεπερτορίου του 3ου επιπέδου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_5</IRI>
        <Literal xml:lang="el">Εξοικείωση με τη σκηνική παρουσία μέσω ερμηνείας μουσικής για κιθάρα σε συναυλίες και γνώση των βασικών πρακτικών μιας επιτυχημένης σκηνικής παρουσίας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_5</IRI>
        <Literal xml:lang="en">Objective 6.5 – Guitar Performance in Concerts and Stage-Presence Practices</Literal>
