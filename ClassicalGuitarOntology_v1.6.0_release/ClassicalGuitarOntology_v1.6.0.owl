    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_1_1_2</IRI>
        <Literal xml:lang="el">Ευχέρεια στη χρήση των συνδυασμών i–m, m–a και i–a του χεριού στην πλευρά του σώματος της κιθάρας.</Literal>
