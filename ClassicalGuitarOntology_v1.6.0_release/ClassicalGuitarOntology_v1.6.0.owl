    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RapidTonicDominantFullBarreChordLocationAndExecution</IRI>
        <Literal xml:lang="el">Γρήγορος εντοπισμός και εκτέλεση ακόρντων τονικής–δεσπόζουσας με ολόκληρο μπαρέ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RasgueadoAttackSpeedControl</IRI>
        <Literal xml:lang="el">Δεξιότητα ελέγχου και προσαρμογής της ταχύτητας κρούσης κατά την εκτέλεση rasgueado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
