        <IRI>#Skill_ArrangementBasedInterpretiveAestheticDevelopment</IRI>
        <Literal xml:lang="el">Δεξιότητα αισθητικής και ερμηνευτικής προσέγγισης διασκευών γνωστών έργων διαφορετικής ιστορικής, γεωγραφικής και στιλιστικής προέλευσης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
