    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BodyPosture</IRI>
        <Literal xml:lang="el">Αναπαριστά τη θέση και τη διάταξη του σώματος του εκτελεστή κατά τη μελέτη, τη διδασκαλία ή την εκτέλεση της κλασικής κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BodyPosture</IRI>
        <Literal xml:lang="en">Body Posture</Literal>
