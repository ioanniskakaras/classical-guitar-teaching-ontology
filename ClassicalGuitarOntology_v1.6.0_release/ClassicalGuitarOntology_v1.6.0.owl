    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BaroqueGuitar</IRI>
        <Literal xml:lang="el">Ιστορικός τύπος κιθάρας της εποχής του Μπαρόκ, ο οποίος παρουσιάζεται στο Πρόγραμμα Σπουδών στο πλαίσιο της ιστορικής εξέλιξης του οργάνου και της μελέτης των συγγενών οργάνων εποχής και εξετάζεται ως προς τα βασικά χαρακτηριστικά του.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BaroqueGuitar</IRI>
        <Literal xml:lang="en">Baroque Guitar</Literal>
    </AnnotationAssertion>
