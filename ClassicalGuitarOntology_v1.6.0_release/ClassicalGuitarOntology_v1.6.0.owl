        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#ImprovisationAndCreativityCategory_Level6</IRI>
        <Literal xml:lang="el">Κατηγορία αυτοσχεδιασμού και δημιουργικότητας – 6ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ImprovisationCategory_Level2</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 2ου επιπέδου που αφορά την ανάπτυξη της δημιουργικής μουσικότητας μέσω καθοδηγούμενου αυτοσχεδιασμού με δοσμένο μελωδικό και ρυθμικό υλικό πάνω σε απλή ρυθμική και αρμονική ακολουθία 4 ή 8 μέτρων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
