        <Literal xml:lang="en">Objective 2.6 – Improvisation Based on Specific Melodic Material</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_2_6</IRI>
        <Literal xml:lang="el">Στόχος 2.6 – Αυτοσχεδιασμός με βάση συγκεκριμένο μελωδικό υλικό</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_3_1_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας αναγνώρισης, ονομασίας, ευχερούς ανάγνωσης και καθαρής εκτέλεσης όλων των φθόγγων της 5ης και της 7ης θέσης, με χρήση κατάλληλων κλιμάκων χωρίς αλλαγή θέσης.</Literal>
    </AnnotationAssertion>
