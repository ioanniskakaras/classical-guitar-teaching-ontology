    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_1_4_5</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης της τεχνικής pizzicato σε κλίμακες, γνωστές μελωδίες, διδαγμένες σπουδές και κατάλληλο έργο ρεπερτορίου.</Literal>
    </AnnotationAssertion>
