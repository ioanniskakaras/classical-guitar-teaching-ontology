    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_SmoothLegatoPositionTransitionInSixthsAndTenthsScales</IRI>
        <Literal xml:lang="el">Δεξιότητα ομαλής και συνδεδεμένης μετάβασης από θέση σε θέση κατά την εκτέλεση κλιμάκων με διαστήματα έκτης και δέκατης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
