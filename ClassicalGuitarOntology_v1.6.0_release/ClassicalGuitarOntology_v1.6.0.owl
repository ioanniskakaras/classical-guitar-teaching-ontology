    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_2_2_1</IRI>
        <Literal xml:lang="el">Στόχος 2.2.1 – Εκτέλεση έργων από το ρεπερτόριο της κιθάρας διαφόρων εποχών και τεχνοτροπιών</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_2_2_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας κατανόησης και εφαρμογής βασικών όρων δυναμικής, ρυθμικής αγωγής και απλών μεταβολών της ταχύτητας, εισαγωγή στην έννοια της μουσικής ερμηνείας και σταδιακή βελτίωση της ποιότητας του παραγόμενου ήχου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
