    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LeftHand</IRI>
        <Literal xml:lang="el">Αναπαριστά το ανατομικά αριστερό χέρι του/της εκτελεστή/τριας. Η λειτουργία του μπορεί να διαφέρει ανάλογα με το αν ο/η μαθητής/τρια παίζει ως δεξιόχειρας ή αριστερόχειρας.</Literal>
    </AnnotationAssertion>
