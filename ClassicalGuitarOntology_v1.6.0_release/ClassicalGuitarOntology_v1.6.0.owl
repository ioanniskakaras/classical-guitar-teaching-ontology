        <IRI>#AncientPeriod</IRI>
        <Literal xml:lang="el">Αρχαία Περίοδος</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#ArpeggioPattern</IRI>
        <Literal xml:lang="el">Διατεταγμένη ακολουθία δαχτύλων του χεριού στην πλευρά του σώματος της κιθάρας, η οποία χρησιμοποιείται για την εκτέλεση αρπισμών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
