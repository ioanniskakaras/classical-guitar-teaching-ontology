    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_1_6</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας ολοκληρωμένης εφαρμογής των τεχνικών του 5ου επιπέδου μέσα από τη μελέτη και εκτέλεση σπουδών μικτής τεχνικής και ευκινησίας των δύο χεριών, με προσαρμογή των διδαχθεισών τεχνικών στο στιλιστικό ύφος διαφορετικών συνθετών και εποχών.</Literal>
    </AnnotationAssertion>
