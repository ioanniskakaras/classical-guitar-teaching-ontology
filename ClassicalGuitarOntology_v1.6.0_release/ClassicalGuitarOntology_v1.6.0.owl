    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicAccompanimentChordApplication</IRI>
        <Literal xml:lang="en">Basic Accompaniment-Chord Application Skill</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicAccompanimentChordApplication</IRI>
        <Literal xml:lang="el">Εφαρμογή βασικών ακόρντων στη συνοδεία</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BasicComposerBiographicalKnowledgeForStudiedExercisesAndWorks</IRI>
        <Literal xml:lang="el">Δεξιότητα γνώσης και συνοπτικής παρουσίασης βασικών βιογραφικών στοιχείων των συνθετών των ασκήσεων, σπουδών και έργων που περιλαμβάνονται στη διδασκαλία του/της μαθητή/τριας, με βασική σύνδεσή τους με την αντίστοιχη ιστορική περίοδο και το διδαγμένο μουσικό υλικό.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicComposerBiographicalKnowledgeForStudiedExercisesAndWorks</IRI>
        <Literal xml:lang="en">Basic Biographical Knowledge of Composers of the Studied Exercises and Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicComposerBiographicalKnowledgeForStudiedExercisesAndWorks</IRI>
        <Literal xml:lang="el">Βασική βιογραφική γνώση των συνθετών των διδαγμένων ασκήσεων και έργων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BasicDynamicMarkingApplication</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης και ορθής εφαρμογής των βασικών όρων δυναμικής p, f, crescendo και decrescendo κατά την εκτέλεση έργων ρεπερτορίου και σπουδών, με ελεγχόμενη διαφοροποίηση της έντασης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicDynamicMarkingApplication</IRI>
        <Literal xml:lang="en">Application of Basic Dynamic Markings</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicDynamicMarkingApplication</IRI>
        <Literal xml:lang="el">Εφαρμογή βασικών όρων δυναμικής</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BasicFullBarreExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα εισαγωγικής εφαρμογής ολόκληρου μπαρέ με κατάλληλη τοποθέτηση του πρώτου δαχτύλου και ελεγχόμενη πίεση στις χορδές.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicFullBarreExecution</IRI>
        <Literal xml:lang="en">Basic Full-Barre Execution</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicFullBarreExecution</IRI>
        <Literal xml:lang="el">Βασική εκτέλεση ολόκληρου μπαρέ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BasicGenreAndFormKnowledgeForPerformedWorks</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης και συνοπτικής περιγραφής του μουσικού είδους και της βασικής μορφής των έργων που μελετά και ερμηνεύει ο/η μαθητής/τρια στο 2ο επίπεδο.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicGenreAndFormKnowledgeForPerformedWorks</IRI>
        <Literal xml:lang="en">Basic Knowledge of Genres and Forms of Performed Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicGenreAndFormKnowledgeForPerformedWorks</IRI>
        <Literal xml:lang="el">Βασική γνώση ειδών και μορφών των ερμηνευόμενων έργων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BasicHistoricalPeriodCharacteristicRecognition</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης βασικών μουσικών, αισθητικών και υφολογικών χαρακτηριστικών των ιστορικών περιόδων που παρουσιάζονται στο 1ο επίπεδο.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicHistoricalPeriodCharacteristicRecognition</IRI>
        <Literal xml:lang="en">Recognition of Fundamental Characteristics of Musical Historical Periods</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicHistoricalPeriodCharacteristicRecognition</IRI>
        <Literal xml:lang="el">Αναγνώριση θεμελιωδών χαρακτηριστικών μουσικών ιστορικών περιόδων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BasicStagePresenceAndConcertProtocol</IRI>
        <Literal xml:lang="el">Δεξιότητα εφαρμογής των βασικών πρακτικών σκηνικής παρουσίας, όπως η αρχική και τελική υπόκλιση και η σαφής έναρξη και ολοκλήρωση του μουσικού έργου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BasicStagePresenceAndConcertProtocol</IRI>
        <Literal xml:lang="en">Basic Stage Presence and Concert Protocol</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BasicStagePresenceAndConcertProtocol</IRI>
        <Literal xml:lang="el">Βασική σκηνική παρουσία και τυπικό συναυλίας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_BodySideFingerCombinationFluency</IRI>
        <Literal xml:lang="el">Δεξιότητα άνετης και σταθερής χρήσης των συνδυασμών i–m, m–a και i–a του χεριού στην πλευρά του σώματος της κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_BodySideFingerCombinationFluency</IRI>
        <Literal xml:lang="en">Fluency in i-m, m-a and i-a Finger Combinations</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_BodySideFingerCombinationFluency</IRI>
        <Literal xml:lang="el">Ευχέρεια στους συνδυασμούς i–m, m–a και i–a</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ChromaticBarreChordTransposition</IRI>
        <Literal xml:lang="el">Δεξιότητα εντοπισμού και χρωματικής μεταφοράς των βασικών μειζόνων και ελασσόνων σχημάτων ακόρντων με μπαρέ σε διαφορετικές θέσεις της ταστιέρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ChromaticBarreChordTransposition</IRI>
        <Literal xml:lang="en">Chromatic Transposition of Barre-Chord Shapes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ChromaticBarreChordTransposition</IRI>
        <Literal xml:lang="el">Χρωματική μεταφορά τυποποιημένων ακόρντων με μπαρέ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ChromaticScaleExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα ομοιόμορφης και καθαρής εκτέλεσης χρωματικών ακολουθιών στην πρώτη θέση και έως το 12ο τάστο.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ChromaticScaleExecution</IRI>
        <Literal xml:lang="en">Chromatic-Scale Execution Skill</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ChromaticScaleExecution</IRI>
        <Literal xml:lang="el">Εκτέλεση χρωματικών κλιμάκων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ClassicalRomanticRepertoireAndComposerHistoryKnowledge</IRI>
        <Literal xml:lang="el">Δεξιότητα συνοπτικής γνώσης της ιστορίας του ρεπερτορίου και των συνθετών του Κλασικισμού και του Ρομαντισμού, με βασική κατανόηση της χρονικής αλληλουχίας και του ιστορικού και γεωγραφικού τους πλαισίου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ClassicalRomanticRepertoireAndComposerHistoryKnowledge</IRI>
        <Literal xml:lang="en">Knowledge of Classical and Romantic Repertoire and Composer History</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ClassicalRomanticRepertoireAndComposerHistoryKnowledge</IRI>
        <Literal xml:lang="el">Γνώση της ιστορίας του ρεπερτορίου και των συνθετών του Κλασικισμού και του Ρομαντισμού</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ClassicalRomanticWorkRecognitionAndDistinction</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης και διάκρισης έργων του Κλασικισμού και του Ρομαντισμού με βάση χαρακτηριστικά των δύο εποχών και σε αντιπαραβολή με προηγούμενες μουσικές εποχές.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ClassicalRomanticWorkRecognitionAndDistinction</IRI>
        <Literal xml:lang="en">Recognition and Distinction of Classical and Romantic Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ClassicalRomanticWorkRecognitionAndDistinction</IRI>
        <Literal xml:lang="el">Αναγνώριση και διάκριση έργων του Κλασικισμού και του Ρομαντισμού</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ClearArticulationAndControlledNailTone</IRI>
        <Literal xml:lang="el">Δεξιότητα παραγωγής καθαρής άρθρωσης και ελεγχόμενης ποιότητας ήχου κατά τη νύξη της χορδής από το νύχι.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ClearArticulationAndControlledNailTone</IRI>
        <Literal xml:lang="en">Clear Articulation and Controlled Nail Tone</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ClearArticulationAndControlledNailTone</IRI>
        <Literal xml:lang="el">Καθαρή άρθρωση και ελεγχόμενη ποιότητα ήχου με νύξη από το νύχι</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ClearBalancedSlurArticulation</IRI>
        <Literal xml:lang="el">Δεξιότητα παραγωγής καθαρών και ισορροπημένων ως προς την ένταση φθόγγων κατά την εκτέλεση ανιόντων και κατιόντων δεμένων φθόγγων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ClearBalancedSlurArticulation</IRI>
        <Literal xml:lang="en">Clear Articulation and Dynamic Balance in Slurs</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ClearBalancedSlurArticulation</IRI>
        <Literal xml:lang="el">Καθαρή άρθρωση και ισορροπία έντασης στους δεμένους φθόγγους</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ClearHalfBarreExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα εφαρμογής μισού μπαρέ με καθαρή απόδοση τόσο των φθόγγων του μπαρέ όσο και των φθόγγων που εκτελούνται από τα υπόλοιπα δάχτυλα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ClearHalfBarreExecution</IRI>
        <Literal xml:lang="en">Clear Half-Barre Execution</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ClearHalfBarreExecution</IRI>
        <Literal xml:lang="el">Καθαρή εκτέλεση μισού μπαρέ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ClearLegatoRemotePositionShiftExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα καθαρής, ακριβούς και δεμένης εκτέλεσης κατά τις μετακινήσεις του χεριού στην πλευρά του λαιμού προς και από απομακρυσμένες θέσεις.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ClearLegatoRemotePositionShiftExecution</IRI>
        <Literal xml:lang="en">Clear Legato Execution of Shifts to Remote Positions</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ClearLegatoRemotePositionShiftExecution</IRI>
        <Literal xml:lang="el">Καθαρή και δεμένη εκτέλεση μετακινήσεων σε απομακρυσμένες θέσεις</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_CommonStyleTermApplication</IRI>
        <Literal xml:lang="el">Δεξιότητα ορθής εφαρμογής συνηθισμένων όρων ύφους, όπως animato, cantabile, dolce, espressivo και grazioso, σύμφωνα με το μουσικό κείμενο.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_CommonStyleTermApplication</IRI>
        <Literal xml:lang="en">Application of Common Style Terms</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_CommonStyleTermApplication</IRI>
        <Literal xml:lang="el">Εφαρμογή συνηθισμένων όρων ύφους</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ComparisonOfAlternativeInterpretivePerspectives</IRI>
        <Literal xml:lang="el">Δεξιότητα διάκρισης και αξιολόγησης διαφορετικών ερμηνευτικών απόψεων, όπως μουσικές φράσεις, μοτίβα και προτάσεις, με καθοδήγηση του/της εκπαιδευτικού.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ComparisonOfAlternativeInterpretivePerspectives</IRI>
        <Literal xml:lang="en">Comparison of Alternative Interpretive Perspectives</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ComparisonOfAlternativeInterpretivePerspectives</IRI>
        <Literal xml:lang="el">Σύγκριση εναλλακτικών ερμηνευτικών προσεγγίσεων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ComplexArpeggioWithThumbRestsExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα γρήγορης και ελεγχόμενης εκτέλεσης σύνθετων αρπισμών με ομοιογένεια έντασης και ηχοχρώματος, διαφορετικούς τονισμούς και παύσεις στον αντίχειρα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ComplexArpeggioWithThumbRestsExecution</IRI>
        <Literal xml:lang="en">Complex Arpeggio Execution with Thumb Rests</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ComplexArpeggioWithThumbRestsExecution</IRI>
        <Literal xml:lang="el">Εκτέλεση σύνθετων αρπισμών με παύσεις στον αντίχειρα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ComplexOrnamentExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα καθαρής, ισορροπημένης και ρυθμικά ακριβούς εκτέλεσης του διπλού ποικίλματος, του mordento και του gruppetto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ComplexOrnamentExecution</IRI>
        <Literal xml:lang="en">Complex Musical-Ornament Execution</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ComplexOrnamentExecution</IRI>
        <Literal xml:lang="el">Εκτέλεση σύνθετων μουσικών ποικιλμάτων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ComposerContextAwarenessForPerformedWorks</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης του/της συνθέτη/τριας, της ιστορικής περιόδου και βασικών συμφραζομένων των ασκήσεων και έργων που εκτελεί ο/η μαθητής/τρια.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ComposerContextAwarenessForPerformedWorks</IRI>
        <Literal xml:lang="en">Basic Awareness of Composers and Historical Context of Performed Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ComposerContextAwarenessForPerformedWorks</IRI>
        <Literal xml:lang="el">Βασική γνώση των συνθετών και του ιστορικού πλαισίου των εκτελούμενων έργων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ContemporaryMusicalIdiomRecognition</IRI>
        <Literal xml:lang="el">Δεξιότητα αναγνώρισης βασικών τεχνοτροπικών και ακουστικών χαρακτηριστικών σύγχρονων μουσικών ιδιωμάτων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ContemporaryMusicalIdiomRecognition</IRI>
        <Literal xml:lang="en">Recognition of Characteristics of Contemporary Musical Idioms</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ContemporaryMusicalIdiomRecognition</IRI>
        <Literal xml:lang="el">Αναγνώριση χαρακτηριστικών σύγχρονων μουσικών ιδιωμάτων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ContemporaryWorkListeningAndResearch</IRI>
        <Literal xml:lang="el">Δεξιότητα ενεργού ακρόασης σύγχρονων έργων και αναζήτησης πρόσθετων ιστορικών, βιογραφικών και τεχνοτροπικών πληροφοριών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ContemporaryWorkListeningAndResearch</IRI>
        <Literal xml:lang="en">Listening to and Researching Contemporary Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ContemporaryWorkListeningAndResearch</IRI>
        <Literal xml:lang="el">Ακρόαση και έρευνα σύγχρονων έργων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ContextualListeningToGreekGuitarWorks</IRI>
        <Literal xml:lang="el">Δεξιότητα ενεργού ακρόασης έργων της ελληνικής κιθαριστικής σχολής από ηχογραφήσεις ή ζωντανές εκτελέσεις και σύνδεσής τους με πληροφορίες για τον συνθέτη, το έργο, τον ερμηνευτή και το ιστορικό τους πλαίσιο.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ContextualListeningToGreekGuitarWorks</IRI>
        <Literal xml:lang="en">Contextual Listening to Works of the Greek Guitar School</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ContextualListeningToGreekGuitarWorks</IRI>
        <Literal xml:lang="el">Ενταγμένη ακρόαση έργων της ελληνικής κιθαριστικής σχολής</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ControlledArpeggioSpeedDevelopment</IRI>
        <Literal xml:lang="el">Δεξιότητα σταδιακής ανάπτυξης της ταχύτητας των αρπισμών χωρίς απώλεια του σταθερού ρυθμού, των σωστών τονισμών και του συντονισμού των δαχτύλων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_ControlledArpeggioSpeedDevelopment</IRI>
        <Literal xml:lang="en">Controlled Development of Arpeggio Execution Speed</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ControlledArpeggioSpeedDevelopment</IRI>
        <Literal xml:lang="el">Ελεγχόμενη ανάπτυξη της ταχύτητας εκτέλεσης αρπισμών</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
