        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RhythmicAccuracyInSlurs</IRI>
        <Literal xml:lang="el">Ρυθμική ακρίβεια στην εκτέλεση δεμένων φθόγγων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RhythmicAndMetronomicControlInStudies</IRI>
        <Literal xml:lang="el">Δεξιότητα τήρησης της προβλεπόμενης ρυθμικής αγωγής και της ένδειξης του μετρονόμου, όπου αυτή αναγράφεται, κατά την εκτέλεση σπουδών μικτής τεχνικής.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
