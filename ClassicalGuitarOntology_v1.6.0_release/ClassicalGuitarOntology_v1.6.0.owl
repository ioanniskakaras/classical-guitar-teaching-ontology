    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_AcousticPrinciplesOfNaturalHarmonics</IRI>
        <Literal xml:lang="el">Δεξιότητα κατανόησης και επεξήγησης του τρόπου παραγωγής των φυσικών αρμονικών με βάση βασικές αρχές της ακουστικής.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
