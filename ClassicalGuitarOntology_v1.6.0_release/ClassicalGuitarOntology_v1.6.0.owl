    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#InstrumentKnowledgeSkill</IRI>
        <Literal xml:lang="el">Δεξιότητα γνώσης του οργάνου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#InterdisciplinarityCategory_Level5</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 5ου επιπέδου που αφορά τη σύζευξη επιστημονικών ή καλλιτεχνικών θεμάτων με τη μουσική και τη συμμετοχή του/της μαθητή/τριας σε διαθεματική δραστηριότητα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#InterdisciplinarityCategory_Level5</IRI>
