    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_3_1_1</IRI>
        <Literal xml:lang="el">Στόχος 3.1.1 – Αναγνώριση και ευχερής ανάγνωση όλων των φθόγγων της 5ης και της 7ης θέσης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_3_1_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας αναγνώρισης, ονομασίας, ανάγνωσης και καθαρής εκτέλεσης των φθόγγων της 1ης χορδής έως το 15ο τάστο, με χρήση των κλιμάκων Φα και Σολ μείζονα σε μία οκτάβα και της χρωματικής κλίμακας από Μι.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_3_1_2</IRI>
