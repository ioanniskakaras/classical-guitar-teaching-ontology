        <IRI>#LO_3_6</IRI>
        <Literal xml:lang="en">Objective 3.6 – Application of ICT in Guitar Music Practice</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_3_6</IRI>
        <Literal xml:lang="el">Στόχος 3.6 – Εφαρμογή των ΤΠΕ στη μουσική κιθαριστική πράξη</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_4_1_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας αναγνώρισης, ονομασίας, ευχερούς ανάγνωσης και καθαρής εκτέλεσης όλων των φθόγγων της 9ης θέσης, με χρήση κατάλληλων κλιμάκων χωρίς αλλαγή θέσης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
