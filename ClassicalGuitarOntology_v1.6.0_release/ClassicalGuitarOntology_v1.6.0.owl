    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Technique_SeventhChordAccompanimentAndHarmonicApplication</IRI>
        <Literal xml:lang="el">Τεχνική αναγνώρισης, ονομασίας, εναλλαγής και εφαρμογής τετράφωνων ακόρντων μεθ’ εβδόμης στη συνοδεία τραγουδιών και γνωστών μελωδιών, σε σύνδεση με βασικές έννοιες αρμονίας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
