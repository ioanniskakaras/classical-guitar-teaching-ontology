        <IRI>#Crit_Level1_AnnualCommitteeSelectedWork</IRI>
        <Literal xml:lang="el">Κριτήριο ετήσιας εξέτασης 1ου επιπέδου: Έργο επιλογής της εξεταστικής επιτροπής</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Crit_Level1_AnnualRepertoirePerformance</IRI>
        <Literal xml:lang="el">Αξιολογεί την εκτέλεση ενός έργου ρεπερτορίου του 1ου επιπέδου με ακρίβεια στις διάρκειες, στη ρυθμική αγωγή και στη μουσική σημειολογία που ορίζει ο/η συνθέτης/τρια.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Crit_Level1_AnnualRepertoirePerformance</IRI>
