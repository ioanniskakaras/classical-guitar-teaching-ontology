    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Technique_SimpleAppoggiaturaExecution</IRI>
        <Literal xml:lang="el">Τεχνική ελεγχόμενης εκτέλεσης απλής appoggiatura, με καθαρή άρθρωση, ισορροπημένη ένταση και ρυθμική ακρίβεια κατά την απόδοση του διακοσμητικού και του κύριου φθόγγου.</Literal>
    </AnnotationAssertion>
