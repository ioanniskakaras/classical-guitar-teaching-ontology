    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Instructor</IRI>
        <Literal xml:lang="el">Αναπαριστά το πρόσωπο που οργανώνει και καθοδηγεί τη διδασκαλία της κλασικής κιθάρας, επιλέγει κατάλληλες διδακτικές πρακτικές και αξιολογεί την πρόοδο του μαθητή ή της μαθήτριας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Instructor</IRI>
        <Literal xml:lang="en">Instructor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Instructor</IRI>
        <Literal xml:lang="el">Δάσκαλος</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Instructor_Main</IRI>
        <Literal xml:lang="el">Ρόλος/πράκτορας που διδάσκει, επιλέγει/προσαρμόζει διδακτικές πρακτικές και αξιολογεί τα κριτήρια του επιπέδου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Instructor_Main</IRI>
        <Literal xml:lang="en">Instructor</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Instructor_Main</IRI>
        <Literal xml:lang="el">Καθηγητής</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Instrument</IRI>
        <Literal xml:lang="el">Αναπαριστά μουσικό όργανο που περιλαμβάνεται στο διδακτικό, ιστορικό ή οργανικό περιεχόμενο της οντολογίας, όπως η κλασική κιθάρα και συγγενή ιστορικά ή σύγχρονα όργανα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Instrument</IRI>
        <Literal xml:lang="en">Instrument</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Instrument</IRI>
        <Literal xml:lang="el">Μουσικό όργανο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#InstrumentKnowledgeSkill</IRI>
        <Literal xml:lang="el">Κατηγορία δεξιοτήτων που αφορά τη γνώση της κιθάρας ως μουσικού οργάνου, την αναγνώριση των μερών της, την κατανόηση της λειτουργίας τους, τη διάκριση τύπων κιθάρας και τη σύνδεση του οργάνου με ιστορικά, αισθητικά και κατασκευαστικά συμφραζόμενα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#InstrumentKnowledgeSkill</IRI>
