    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_1_5_4</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ευχέρειας στις αλλαγές θέσεων από την 1η έως την 9η θέση και έως το 12ο τάστο, με σταδιακή εφαρμογή χωρίς οπτική επαφή με την ταστιέρα.</Literal>
