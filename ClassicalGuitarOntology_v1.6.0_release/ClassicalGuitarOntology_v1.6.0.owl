    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Technique_SimultaneousDoubleAscendingSlurExecution</IRI>
        <Literal xml:lang="el">Τεχνική ταυτόχρονης εκτέλεσης ανιόντων δεμένων φθόγγων σε δύο χορδές, με δυνατότητα εφαρμογής και με μπαρέ.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
