    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_2_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας μελέτης και ολοκληρωμένης εκτέλεσης έργων του κιθαριστικού ρεπερτορίου από διαφορετικές ιστορικές περιόδους και τεχνοτροπίες, με εφαρμογή των τεχνικών του 5ου επιπέδου και συστηματική διαχείριση ενεργού ρεπερτορίου.</Literal>
    </AnnotationAssertion>
