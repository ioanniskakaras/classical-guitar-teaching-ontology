        <Literal xml:lang="en">Two-Octave Major-Scale Execution Technique</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Technique_TwoOctaveMajorScaleExecution</IRI>
        <Literal xml:lang="el">Τεχνική εκτέλεσης μειζόνων κλιμάκων δύο οκτάβων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Technique_TwoOctaveMajorScaleInThirdsExecution</IRI>
        <Literal xml:lang="el">Τεχνική εκτέλεσης μειζόνων κλιμάκων σε διαστήματα τρίτης και σε έκταση δύο οκτάβων, με δυνατότητα μεταφοράς σε διαφορετικές τονικότητες με διατήρηση της ίδιας δακτυλοθεσίας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
