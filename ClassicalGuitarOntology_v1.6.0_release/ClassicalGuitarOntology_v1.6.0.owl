    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_5_4_1</IRI>
        <Literal xml:lang="en">Objective 5.4.1 – Performance of an Unfamiliar Tonal Music Text in Seventh Position</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_4_1</IRI>
        <Literal xml:lang="el">Στόχος 5.4.1 – Εκτέλεση άγνωστου τονικού μουσικού κειμένου στην 7η θέση</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_4_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας prima vista σε βασικά ομοφωνικά έργα, με εναλλαγές μεταξύ 1ης και 2ης θέσης, χρήση μπάσων, συγχορδιών και απλών δεμένων φθόγγων και εφαρμογή βασικών όρων δυναμικής και tempo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_5_4_2</IRI>
        <Literal xml:lang="en">Objective 5.4.2 – Alternation between First and Second Positions with Bass Notes, Chords, and Simple Slurs</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_4_2</IRI>
        <Literal xml:lang="el">Στόχος 5.4.2 – Εναλλαγές 1ης και 2ης θέσης με μπάσα, συγχορδίες και απλούς δεμένους φθόγγους</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_4_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκ πρώτης όψεως ανάγνωσης αδίδακτων έργων που αντιστοιχούν στον βαθμό δυσκολίας του 2ου επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_5_4_3</IRI>
        <Literal xml:lang="en">Objective 5.4.3 – Sight-Reading Works from the Level 2 Repertoire</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_4_3</IRI>
        <Literal xml:lang="el">Στόχος 5.4.3 – Ανάγνωση έργων του ρεπερτορίου του 2ου επιπέδου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_5</IRI>
        <Literal xml:lang="el">Εξοικείωση με τη σκηνική παρουσία μέσω ερμηνείας μουσικής για κιθάρα σε συναυλίες και γνώση των βασικών πρακτικών επιτυχημένης σκηνικής παρουσίας. Προβλέπονται δύο εμφανίσεις κατά τη σχολική χρονιά, από τις οποίες η μία με πρόγραμμα για σόλο κιθάρα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_5_5</IRI>
        <Literal xml:lang="en">Objective 5.5 – Guitar Performance in Concerts and Stage-Presence Practices</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_5</IRI>
        <Literal xml:lang="el">Στόχος 5.5 – Εκτέλεση μουσικής για κιθάρα σε συναυλίες και πρακτικές σκηνικής παρουσίας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_5_6</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας σύνδεσης επιστημονικών ή καλλιτεχνικών θεμάτων με τη μουσική μέσω συμμετοχής σε διαθεματική δραστηριότητα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_5_6</IRI>
        <Literal xml:lang="en">Objective 5.6 – Integration of Scientific or Artistic Topics with Music</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_5_6</IRI>
        <Literal xml:lang="el">Στόχος 5.6 – Σύζευξη επιστημονικών ή καλλιτεχνικών θεμάτων με τη μουσική</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_1</IRI>
        <Literal xml:lang="el">Εδραίωση και περαιτέρω ανάπτυξη της εκτέλεσης των ήδη διδαχθεισών κλιμάκων, με συνέχιση της μελέτης κλιμάκων δύο και τριών οκτάβων και κλιμάκων με διαστήματα τρίτης, εφαρμογή ρυθμικών μοτίβων και εξατομικευμένη ανάπτυξη της ταχύτητας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_1</IRI>
        <Literal xml:lang="en">Objective 6.1.1 – Scales: New Practice Techniques for Previously Learned Scales</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_1</IRI>
        <Literal xml:lang="el">Στόχος 6.1.1 – Κλίμακες: νέες τεχνικές μελέτης στις διδαχθείσες κλίμακες</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_1_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης των μειζόνων κλιμάκων Ντο και Σολ με διαστήματα έκτης σε μία οκτάβα και μεταφοράς τους στις προβλεπόμενες τονικότητες με διατήρηση της αντίστοιχης δακτυλοθεσίας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_1_1</IRI>
        <Literal xml:lang="en">Objective 6.1.1.1 – Major Scales in Sixths over One Octave</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_1_1</IRI>
        <Literal xml:lang="el">Στόχος 6.1.1.1 – Μείζονες κλίμακες με διαστήματα έκτης σε μία οκτάβα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_1_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας καθαρής και σταθερής εκτέλεσης των μειζόνων κλιμάκων Ντο και Σολ με διαστήματα δέκατης σε μία οκτάβα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_1_2</IRI>
        <Literal xml:lang="en">Objective 6.1.1.2 – Major Scales in Tenths over One Octave</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_1_2</IRI>
        <Literal xml:lang="el">Στόχος 6.1.1.2 – Μείζονες κλίμακες με διαστήματα δέκατης σε μία οκτάβα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_1_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης χρωματικής κλίμακας από μι με διαστήματα οκτάβας σε δύο οκτάβες και με χρήση ανοικτών χορδών, με τη δεύτερη οκτάβα να εκτελείται στην 1η και την 3η χορδή.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_1_3</IRI>
        <Literal xml:lang="en">Objective 6.1.1.3 – Chromatic Scale in Octaves over Two Octaves</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_1_3</IRI>
        <Literal xml:lang="el">Στόχος 6.1.1.3 – Χρωματική κλίμακα με διαστήματα οκτάβας σε δύο οκτάβες</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_2</IRI>
        <Literal xml:lang="el">Εμπέδωση και περαιτέρω ανάπτυξη των αρπέζ του 5ου επιπέδου, με αξιοποίηση των προηγούμενων ασκήσεων και τεχνικών και με στόχο τη βελτίωση της ποιότητας του ήχου και της ταχύτητας εκτέλεσης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_2</IRI>
        <Literal xml:lang="en">Objective 6.1.2 – Chord Arpeggios: Consolidation and Application of Previous Exercises and Techniques</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_2</IRI>
        <Literal xml:lang="el">Στόχος 6.1.2 – Αρπέζ: εμπέδωση και αξιοποίηση προηγούμενων ασκήσεων και τεχνικών</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_2_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας καθαρής και ελεγχόμενης εκτέλεσης αρπέζ δεσποζουσών μεθ’ εβδόμης σε δύο οκτάβες, με ενδεικτικό παράδειγμα το ανιόν αρπέζ της Σολ μείζονος μεθ’ εβδόμης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_2_1</IRI>
        <Literal xml:lang="en">Objective 6.1.2.1 – Dominant-Seventh Chord Arpeggios over Two Octaves</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_2_1</IRI>
        <Literal xml:lang="el">Στόχος 6.1.2.1 – Αρπέζ δεσποζουσών μεθ’ εβδόμης σε δύο οκτάβες</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_2_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης αρπέζ ελαττωμένων συγχορδιών με ελαττωμένη έβδομη σε χρωματική ακολουθία, με καθαρότητα, θεωρητική κατανόηση και έλεγχο του παραγόμενου ήχου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_2_2</IRI>
        <Literal xml:lang="en">Objective 6.1.2.2 – Diminished-Seventh Chord Arpeggios in Chromatic Sequence</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_2_2</IRI>
        <Literal xml:lang="el">Στόχος 6.1.2.2 – Αρπέζ ελαττωμένων συγχορδιών με ελαττωμένη έβδομη σε χρωματική ακολουθία</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_3</IRI>
        <Literal xml:lang="el">Επανάληψη, διατήρηση και περαιτέρω ανάπτυξη βασικών ασκήσεων αρπισμών και tremolo του χεριού στην πλευρά του σώματος της κιθάρας. Ο/Η εκπαιδευτικός επιλέγει τις ασκήσεις που χρειάζονται για τη διατήρηση και τη βελτίωση των τεχνικών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_3</IRI>
        <Literal xml:lang="en">Objective 6.1.3 – Technique and Agility of the Guitar-Body-Side Hand</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_3</IRI>
        <Literal xml:lang="el">Στόχος 6.1.3 – Τεχνική και ευκινησία του χεριού στην πλευρά του σώματος της κιθάρας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_3_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη ταχύτητας, ομοιογένειας έντασης και ηχοχρώματος σε σύνθετους αρπισμούς, με διαφορετικά ρυθμικά μοτίβα και τονισμούς, εκτέλεση αρπισμών με παύσεις στον αντίχειρα και τελειοποίηση του tremolo για έργα μεγαλύτερης διάρκειας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_3_1</IRI>
        <Literal xml:lang="en">Objective 6.1.3.1 – Complex Arpeggios and Mature Tremolo Execution</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_3_1</IRI>
        <Literal xml:lang="el">Στόχος 6.1.3.1 – Σύνθετοι αρπισμοί και ώριμη εκτέλεση tremolo</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_3_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας καθαρής παραγωγής τεχνητών αρμονικών φθόγγων με ταυτόχρονη κρούση άλλων φθόγγων από τον αντίχειρα.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_3_2</IRI>
        <Literal xml:lang="en">Objective 6.1.3.2 – Artificial Harmonics with Simultaneous Thumb Notes</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_3_2</IRI>
        <Literal xml:lang="el">Στόχος 6.1.3.2 – Τεχνητοί αρμονικοί με ταυτόχρονη κρούση φθόγγων από τον αντίχειρα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_3_3</IRI>
        <Literal xml:lang="el">Προέκταση της τεχνικής rasgueado και ανάπτυξη της ικανότητας εφαρμογής των τεχνικών golpe και tambora σε απλές διαδοχές ακόρντων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_3_3</IRI>
        <Literal xml:lang="en">Objective 6.1.3.3 – Rasgueado, Golpe, and Tambora in Simple Chord Progressions</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_3_3</IRI>
        <Literal xml:lang="el">Στόχος 6.1.3.3 – Rasgueado, golpe και tambora σε απλές διαδοχές ακόρντων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_4</IRI>
        <Literal xml:lang="el">Γενικός μαθησιακός στόχος του 6ου επιπέδου που αφορά τη διατήρηση και την περαιτέρω ανάπτυξη της τεχνικής, της ευκινησίας και του ελέγχου του χεριού στην πλευρά του λαιμού της κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_4</IRI>
        <Literal xml:lang="en">Objective 6.1.4 – Technique and Agility of the Guitar-Neck-Side Hand</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_4</IRI>
        <Literal xml:lang="el">Στόχος 6.1.4 – Τεχνική και ευκινησία του χεριού στην πλευρά του λαιμού της κιθάρας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_4_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας καθαρής, ισορροπημένης και ρυθμικά ακριβούς εκτέλεσης σύνθετων μουσικών ποικιλμάτων, συμπεριλαμβανομένων του διπλού ποικίλματος, του mordento και του gruppetto.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_4_1</IRI>
        <Literal xml:lang="en">Objective 6.1.4.1 – Complex Musical Ornaments</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_4_1</IRI>
        <Literal xml:lang="el">Στόχος 6.1.4.1 – Σύνθετα μουσικά ποικίλματα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_4_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ευχέρειας μετακίνησης του χεριού στην πλευρά του λαιμού της κιθάρας από και προς κάθε ενδιάμεση θέση, από την 1η έως τη 13η, με ακρίβεια, καθαρότητα και δεμένη άρθρωση όπου απαιτείται.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_4_2</IRI>
        <Literal xml:lang="en">Objective 6.1.4.2 – Guitar-Neck-Side Hand Movement to Remote Positions</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_4_2</IRI>
        <Literal xml:lang="el">Στόχος 6.1.4.2 – Μετακίνηση του χεριού στην πλευρά του λαιμού σε απομακρυσμένες θέσεις</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_4_3</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ανεξαρτησίας και της ελαστικότητας των δαχτύλων του χεριού στην πλευρά του λαιμού της κιθάρας μέσω ήπιων ασκήσεων και συστηματικής ενσωμάτωσής τους στην καθημερινή μελέτη.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_4_3</IRI>
        <Literal xml:lang="en">Objective 6.1.4.3 – Finger Independence and Flexibility</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_4_3</IRI>
        <Literal xml:lang="el">Στόχος 6.1.4.3 – Ανεξαρτησία και ελαστικότητα των δαχτύλων</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_5</IRI>
        <Literal xml:lang="el">Ανάπτυξη ευχέρειας στη χρήση των συγχορδιών που διδάχθηκαν στα προηγούμενα επίπεδα και επέκταση του λεξιλογίου με μείζονες και ελάσσονες συγχορδίες που φέρουν μικρή ή μεγάλη έβδομη.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_5</IRI>
        <Literal xml:lang="en">Objective 6.1.5 – Three- and Four-Note Chords</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_5</IRI>
        <Literal xml:lang="el">Στόχος 6.1.5 – Τρίφωνες και τετράφωνες συγχορδίες</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_5_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας σχεδιασμού έντεχνης συνοδείας τραγουδιού με ενδιαφέρουσες και λειτουργικά ενταγμένες μελωδικές γραμμές στο μπάσο και στις υψηλότερες χορδές.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_5_1</IRI>
        <Literal xml:lang="en">Objective 6.1.5.1 – Artful Song Accompaniment</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_5_1</IRI>
        <Literal xml:lang="el">Στόχος 6.1.5.1 – Έντεχνη συνοδεία τραγουδιού</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_1_6</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας ολοκληρωμένης εφαρμογής των τεχνικών του 6ου επιπέδου μέσα από τη μελέτη και εκτέλεση σπουδών μικτής τεχνικής και ευκινησίας των δύο χεριών, με προσαρμογή στο στιλιστικό ύφος διαφορετικών συνθετών και εποχών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_1_6</IRI>
        <Literal xml:lang="en">Objective 6.1.6 – Performance of Mixed-Technique Studies</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_1_6</IRI>
        <Literal xml:lang="el">Στόχος 6.1.6 – Εκτέλεση σπουδών μικτής τεχνικής</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_2_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας γνώσης, μελέτης και ολοκληρωμένης εκτέλεσης έργων του κιθαριστικού ρεπερτορίου με διαφοροποιημένα χαρακτηριστικά ως προς την ιστορική περίοδο, το ύφος και την τεχνοτροπία, με αξιοποίηση των δεξιοτήτων που έχουν αποκτηθεί έως το 6ο επίπεδο.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_2_1</IRI>
        <Literal xml:lang="en">Objective 6.2.1 – Performance of Works from the Guitar Repertoire</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_2_1</IRI>
        <Literal xml:lang="el">Στόχος 6.2.1 – Εκτέλεση έργων από το ρεπερτόριο της κιθάρας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_2_2</IRI>
        <Literal xml:lang="el">Εμπέδωση, εφαρμογή και περαιτέρω εξέλιξη των μουσικών και ερμηνευτικών δεξιοτήτων του 5ου επιπέδου, με στόχο την ωρίμανση και ανάδειξη της προσωπικής ερμηνευτικής ταυτότητας του/της μαθητή/τριας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_2_2</IRI>
        <Literal xml:lang="en">Objective 6.2.2 – Development of Musical Skills and Interpretive Personality</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_2_2</IRI>
        <Literal xml:lang="el">Στόχος 6.2.2 – Ανάπτυξη μουσικών δεξιοτήτων και ανάδειξη της ερμηνευτικής προσωπικότητας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_3</IRI>
        <Literal xml:lang="el">Γνωριμία με τη σύγχρονη ελληνική κιθαριστική σχολή, τους συνθέτες, τα έργα, τους ερμηνευτές και τους κατασκευαστές οργάνων που συνδέονται με την ιστορική της εξέλιξη.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_3</IRI>
        <Literal xml:lang="en">Objective 6.3 – Introduction to the Modern Greek Guitar School</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_3</IRI>
        <Literal xml:lang="el">Στόχος 6.3 – Γνωριμία με τη σύγχρονη ελληνική κιθαριστική σχολή</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_4_1</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκ πρώτης όψεως ανάγνωσης και εκτέλεσης άγνωστου τονικού μουσικού κειμένου στην 9η θέση.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_4_1</IRI>
        <Literal xml:lang="en">Objective 6.4.1 – Performance of an Unfamiliar Tonal Music Text in Ninth Position</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_6_4_1</IRI>
        <Literal xml:lang="el">Στόχος 6.4.1 – Εκτέλεση άγνωστου τονικού μουσικού κειμένου στην 9η θέση</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_6_4_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας prima vista με εναλλαγές μεταξύ 1ης και 5ης θέσης, χρήση μπάσων, συγχορδιών και αλλοιωμένων φθόγγων και εφαρμογή βασικών όρων δυναμικής και tempo.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_6_4_2</IRI>
        <Literal xml:lang="en">Objective 6.4.2 – Alternation between First and Fifth Positions with Bass Notes, Chords, and Accidentals</Literal>
