    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_1_1_7</IRI>
        <Literal xml:lang="el">Εκτέλεση απλών αρπισμών με συντονισμένη χρήση των δαχτύλων p, i, m και a και εφαρμογή των βασικών αρπισματικών σχημάτων p–i–m–a–m–i, p–i–m–a–i–m και p–i–m–i–a–i–m–i.</Literal>
    </AnnotationAssertion>
