        <Literal xml:lang="en">Recognition and Distinction of Renaissance and Baroque Works</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RenaissanceBaroqueWorkRecognitionAndDistinction</IRI>
        <Literal xml:lang="el">Αναγνώριση και διάκριση έργων Αναγέννησης και Μπαρόκ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RepertoireManagementAndMemoryPerformance</IRI>
        <Literal xml:lang="el">Δεξιότητα επιλογής, διατήρησης, ανανέωσης και εκτέλεσης από μνήμης ενεργού ρεπερτορίου τουλάχιστον πέντε έργων κατάλληλης δυσκολίας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_RepertoireManagementAndMemoryPerformance</IRI>
        <Literal xml:lang="en">Active Repertoire Management and Performance from Memory</Literal>
    </AnnotationAssertion>
