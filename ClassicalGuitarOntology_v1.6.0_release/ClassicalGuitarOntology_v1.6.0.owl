        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Topic</IRI>
        <Literal xml:lang="el">Θέμα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Torso</IRI>
        <Literal xml:lang="el">Αναπαριστά τον κορμό του εκτελεστή ως μέρος της σωματικής στάσης που συμβάλλει στην ισορροπία, στη σταθερότητα και στην ορθή τοποθέτηση κατά την εκτέλεση της κλασικής κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
