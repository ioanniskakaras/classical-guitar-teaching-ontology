        <Literal xml:lang="en">Rasgueado Attack-Speed Control</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RasgueadoAttackSpeedControl</IRI>
        <Literal xml:lang="el">Έλεγχος ταχύτητας κρούσης στο rasgueado</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RasgueadoEvenIntensityAndRhythm</IRI>
        <Literal xml:lang="el">Δεξιότητα διατήρησης ομοιογενούς έντασης και σταθερού ρυθμού κατά την εκτέλεση rasgueado.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_RasgueadoEvenIntensityAndRhythm</IRI>
        <Literal xml:lang="en">Even Intensity and Rhythm in Rasgueado</Literal>
    </AnnotationAssertion>
