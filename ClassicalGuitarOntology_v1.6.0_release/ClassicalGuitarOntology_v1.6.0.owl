        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#BaroqueGuitar</IRI>
        <Literal xml:lang="el">Μπαρόκ κιθάρα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BaroquePeriod</IRI>
        <Literal xml:lang="el">Αναφέρεται στην περίοδο του Μπαρόκ (περ. 1600–1750), σημαντική για το κιθαριστικό ρεπερτόριο και την εξέλιξη των τεχνικών</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
