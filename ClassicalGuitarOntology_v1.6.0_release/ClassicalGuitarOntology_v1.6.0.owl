    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_4_1_5</IRI>
        <Literal xml:lang="el">Γενικός μαθησιακός στόχος του 4ου επιπέδου που αφορά την περαιτέρω ανάπτυξη της τεχνικής και της ευκινησίας του χεριού στην πλευρά του λαιμού της κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_4_1_5</IRI>
        <Literal xml:lang="en">Objective 4.1.5 – Technique and Agility of the Guitar-Neck-Side Hand</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
