        <Literal xml:lang="el">Στόχος 4.1.5.1 – Τριπλοί ανιόντες, κατιόντες και μικτοί δεμένοι φθόγγοι</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_4_1_5_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας εκτέλεσης διπλής appoggiatura με καθαρή και ισορροπημένη άρθρωση και ρυθμική ακρίβεια.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
