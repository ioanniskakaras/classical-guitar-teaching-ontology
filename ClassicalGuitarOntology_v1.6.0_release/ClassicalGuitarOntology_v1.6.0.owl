    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_AccurateDynamicAndArticulationSymbolApplicationInStudies</IRI>
        <Literal xml:lang="el">Ακριβής απόδοση συμβόλων δυναμικής, στίξης και άρθρωσης στις σπουδές</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_AccurateNeckSideFingerPlacement</IRI>
        <Literal xml:lang="el">Δεξιότητα ορθής και ακριβούς τοποθέτησης των δαχτύλων του χεριού στην πλευρά του λαιμού της κιθάρας κατά την εκτέλεση των επιμέρους συνδυασμών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_AccurateNeckSideFingerPlacement</IRI>
