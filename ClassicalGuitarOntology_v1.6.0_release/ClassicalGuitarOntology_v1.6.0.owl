        <Literal xml:lang="en">Objective 2.3.1 – History of the Guitar from Antiquity to the Present</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_2_3_1</IRI>
        <Literal xml:lang="el">Στόχος 2.3.1 – Ιστορία της κιθάρας από την αρχαιότητα έως σήμερα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_2_3_2</IRI>
        <Literal xml:lang="el">Ανάπτυξη της αισθητικής καλλιέργειας του/της μαθητή/τριας μέσω καθοδηγούμενης ακρόασης ενδεικτικών ηχητικών παραδειγμάτων ιστορικών οργάνων και εξοικείωσης με τον ιδιαίτερο ηχητικό χαρακτήρα τους.</Literal>
