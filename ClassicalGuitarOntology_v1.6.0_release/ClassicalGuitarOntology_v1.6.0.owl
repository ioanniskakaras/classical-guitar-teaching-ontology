    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_3_5</IRI>
        <Literal xml:lang="el">Στόχος 3.5 – Συμμετοχή σε σχολικές συναυλίες και μουσικά σύνολα με επιτυχημένη σκηνική παρουσία</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_3_6</IRI>
        <Literal xml:lang="el">Ανάπτυξη της ικανότητας αξιοποίησης των ΤΠΕ στη μουσική κιθαριστική πράξη, τόσο κατά τη διάρκεια του μαθήματος όσο και στη μελέτη στο σπίτι, με σκοπό τη διεύρυνση των γνώσεων και των μουσικών εμπειριών του/της μαθητή/τριας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
