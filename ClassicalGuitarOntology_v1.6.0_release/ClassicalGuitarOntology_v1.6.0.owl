    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ProgressiveToneQualityControl</IRI>
        <Literal xml:lang="el">Δεξιότητα σταδιακής παραγωγής περισσότερο ελεγχόμενου, καθαρού και σταθερού ήχου, με κατάλληλη νύξη και με επίγνωση της επίδρασης που έχουν το σχήμα και η φροντίδα των νυχιών στην ποιότητα του παραγόμενου ήχου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
