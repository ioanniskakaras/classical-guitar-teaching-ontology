        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_ProgressiveToneQualityControl</IRI>
        <Literal xml:lang="el">Σταδιακός έλεγχος και βελτίωση της ποιότητας του ήχου</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RapidTonicDominantFullBarreChordLocationAndExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα γρήγορου εντοπισμού στην ταστιέρα και καθαρής εκτέλεσης των ακόρντων τονικής και δεσπόζουσας με χρήση ολόκληρου μπαρέ.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_RapidTonicDominantFullBarreChordLocationAndExecution</IRI>
