        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Level_3</IRI>
        <Literal xml:lang="el">3ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Level_4</IRI>
        <Literal xml:lang="el">4ο Επίπεδο εκμάθησης της κλασικής κιθάρας σύμφωνα με το Πρόγραμμα Σπουδών. Αποτελεί οργανωτική ενότητα των στόχων 4.1–4.6: Τεχνική, Ερμηνεία, Ιστορία του Οργάνου, Κριτική και Αισθητική Καλλιέργεια, Εκ Πρώτης Όψεως Ανάγνωση, Παράσταση και Απλές Μεταγραφές. Περιλαμβάνει επίσης τις ελάχιστες απαιτήσεις του επιπέδου και την αξιολόγηση των ετήσιων εξετάσεων, όπως ορίζονται στο Πρόγραμμα Σπουδών.</Literal>
    </AnnotationAssertion>
