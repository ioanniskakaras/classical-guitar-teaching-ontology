        <Literal xml:lang="el">Μεταφορά κλιμάκων με διατήρηση της ίδιας δακτυλοθεσίας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_FluentSeventhChordChange</IRI>
