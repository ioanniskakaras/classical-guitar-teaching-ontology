    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#RepertoireCategory</IRI>
        <Literal xml:lang="el">Κατηγορία που χρησιμοποιείται για την οργάνωση έργων ρεπερτορίου με βάση κοινά μουσικά ή πολιτισμικά χαρακτηριστικά, ανεξάρτητα από την ιστορική περίοδο.</Literal>
    </AnnotationAssertion>
