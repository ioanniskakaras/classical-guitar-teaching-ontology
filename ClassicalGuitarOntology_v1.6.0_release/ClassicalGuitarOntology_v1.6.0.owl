    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_SecondPositionFretboardRecognitionAndNaming</IRI>
        <Literal xml:lang="el">Δεξιότητα αντιστοίχισης των γραπτών φθόγγων με τις αντίστοιχες θέσεις τους στην ταστιέρα και ορθής και γρήγορης ονομασίας τους στη 2η θέση.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
