    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#BodySideFinger</IRI>
        <Literal xml:lang="el">Αναπαριστά δάχτυλο του χεριού που λειτουργεί στην πλευρά του σώματος και του ηχείου της κιθάρας. Τα δάχτυλα αυτής της κατηγορίας χρησιμοποιούνται για τη νύξη των χορδών και δηλώνονται παιδαγωγικά ως p, i, m, a και c.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#BodySideFinger</IRI>
        <Literal xml:lang="en">Body-side finger</Literal>
