    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RelaxedTremoloExecution</IRI>
        <Literal xml:lang="el">Δεξιότητα εκτέλεσης της τεχνικής tremolo με χαλαρό και ελεγχόμενο χέρι στην πλευρά του σώματος και του ηχείου.</Literal>
    </AnnotationAssertion>
