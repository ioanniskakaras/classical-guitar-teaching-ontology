    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#AncientPeriod</IRI>
        <Literal xml:lang="el">Περίοδος της αρχαίας μουσικής πριν από τη μεσαιωνική εποχή, η οποία περιλαμβάνει μουσικές παραδόσεις της αρχαίας Ελλάδας και της ελληνορωμαϊκής αρχαιότητας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#AncientPeriod</IRI>
        <Literal xml:lang="en">Ancient Period</Literal>
