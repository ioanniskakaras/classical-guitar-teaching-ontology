        <IRI>#Skill_ArpeggiatedAccompanimentOfSongsAndSolfege</IRI>
        <Literal xml:lang="el">Αρπισματική συνοδεία τραγουδιών και μουσικού υλικού σολφέζ</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_ArpeggiatoEvenIntensityAndRhythm</IRI>
        <Literal xml:lang="el">Δεξιότητα διατήρησης ομοιογενούς έντασης και σταθερού ρυθμού κατά την εκτέλεση arpeggiato.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
