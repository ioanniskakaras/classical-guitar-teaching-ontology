    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoricalPeriod</IRI>
        <Literal xml:lang="el">Κάθε ιστορική περίοδος που χαρακτηρίζει συγκεκριμένο μουσικό στυλ, κοινωνικοπολιτισμικό πλαίσιο και αισθητικές τάσεις.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoricalPeriod</IRI>
        <Literal xml:lang="en">Historical Period</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoricalPeriod</IRI>
        <Literal xml:lang="el">Ιστορική Περίοδος</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsCategory_Level1</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 1ου επιπέδου που αφορά τη βασική γνώση του οργάνου, την αναγνώριση των μερών της κιθάρας και της λειτουργίας τους, καθώς και την εισαγωγή του μαθητή στις μουσικές ιστορικές περιόδους και στους συνθέτες που συνδέονται με το ρεπερτόριο του επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoryAndAestheticsCategory_Level1</IRI>
        <Literal xml:lang="en">Instrument History, Critical and Aesthetic Development – Level 1</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoryAndAestheticsCategory_Level1</IRI>
        <Literal xml:lang="el">Ιστορία του οργάνου, κριτική και αισθητική καλλιέργεια – 1ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsCategory_Level2</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 2ου επιπέδου που αφορά τη συνοπτική ιστορία της κιθάρας από την αρχαιότητα έως σήμερα, τη γνωριμία με τους προγόνους και την εξέλιξη του οργάνου, την αισθητική καλλιέργεια και τα βασικά βιογραφικά στοιχεία των συνθετών των διδαγμένων έργων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoryAndAestheticsCategory_Level2</IRI>
        <Literal xml:lang="en">Instrument History, Critical and Aesthetic Development – Level 2</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoryAndAestheticsCategory_Level2</IRI>
        <Literal xml:lang="el">Ιστορία του οργάνου, κριτική και αισθητική καλλιέργεια – 2ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsCategory_Level3</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 3ου επιπέδου που αφορά τη συνοπτική ιστορία του ρεπερτορίου, των συνθετών και των συγγενών με την κιθάρα οργάνων της Αναγέννησης και του Μπαρόκ, καθώς και την αισθητική καλλιέργεια μέσω της αναγνώρισης και διάκρισης έργων των δύο εποχών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoryAndAestheticsCategory_Level3</IRI>
        <Literal xml:lang="en">Instrument History, Critical and Aesthetic Development – Level 3</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoryAndAestheticsCategory_Level3</IRI>
        <Literal xml:lang="el">Ιστορία του οργάνου, κριτική και αισθητική καλλιέργεια – 3ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsCategory_Level4</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 4ου επιπέδου που αφορά τη συνοπτική γνώση της ιστορίας του ρεπερτορίου και των συνθετών του Κλασικισμού και του Ρομαντισμού, καθώς και την αναγνώριση, διάκριση και αισθητική προσέγγιση έργων των δύο εποχών.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoryAndAestheticsCategory_Level4</IRI>
        <Literal xml:lang="en">Instrument History, Critical and Aesthetic Development – Level 4</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoryAndAestheticsCategory_Level4</IRI>
        <Literal xml:lang="el">Ιστορία του οργάνου, κριτική και αισθητική καλλιέργεια – 4ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsCategory_Level5</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 5ου επιπέδου που αφορά την απόκτηση συνοπτικών γνώσεων για την ιστορία του κιθαριστικού ρεπερτορίου και τους συνθέτες του 20ού και του 21ου αιώνα, την ακρόαση σύγχρονων έργων και την αναγνώριση χαρακτηριστικών των σύγχρονων μουσικών ιδιωμάτων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoryAndAestheticsCategory_Level5</IRI>
        <Literal xml:lang="en">Instrument History, Critical and Aesthetic Development – Level 5</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoryAndAestheticsCategory_Level5</IRI>
        <Literal xml:lang="el">Ιστορία του οργάνου, κριτική και αισθητική καλλιέργεια – 5ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsCategory_Level6</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων του 6ου επιπέδου που αφορά τη γνωριμία με τη σύγχρονη ελληνική κιθαριστική σχολή, τους συνθέτες, τα έργα, τους ερμηνευτές και τους κατασκευαστές οργάνων της, καθώς και την ακρόαση, έρευνα και συνοπτική παρουσίαση σχετικών θεμάτων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#HistoryAndAestheticsCategory_Level6</IRI>
        <Literal xml:lang="en">Instrument History, Critical and Aesthetic Development – Level 6</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#HistoryAndAestheticsCategory_Level6</IRI>
        <Literal xml:lang="el">Ιστορία του οργάνου, κριτική και αισθητική καλλιέργεια – 6ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#HistoryAndAestheticsObjectiveCategory</IRI>
        <Literal xml:lang="el">Βασικές γνώσεις ιστορικών περιόδων και αισθητικής της κιθάρας</Literal>
