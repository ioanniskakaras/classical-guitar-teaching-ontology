        <Literal xml:lang="en">Consistent Participation in Rehearsals and Musical Ensembles</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RehearsalAndEnsembleParticipation</IRI>
        <Literal xml:lang="el">Συνεπής συμμετοχή σε πρόβες και μουσικά σύνολα</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RelaxedClearNeckSideFingerMovement</IRI>
        <Literal xml:lang="el">Δεξιότητα εκτέλεσης των συνδυασμών με χαλαρότητα των κινήσεων, καθαρή άρθρωση και καθαρότητα των παραγόμενων φθόγγων.</Literal>
