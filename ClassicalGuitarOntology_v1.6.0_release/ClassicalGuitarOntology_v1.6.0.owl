    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RhythmicAccuracyInNeckSideTechniqueExercises</IRI>
        <Literal xml:lang="el">Δεξιότητα σταθερής και ακριβούς ρυθμικής εκτέλεσης στις ασκήσεις τεχνικής και ευκινησίας του χεριού στην πλευρά του λαιμού της κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_RhythmicAccuracyInNeckSideTechniqueExercises</IRI>
        <Literal xml:lang="en">Rhythmic Accuracy in Guitar-Neck-Side Hand Technique Exercises</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#Skill_RhythmicAccuracyInNeckSideTechniqueExercises</IRI>
        <Literal xml:lang="el">Ρυθμική ακρίβεια στις ασκήσεις τεχνικής του χεριού στην πλευρά του λαιμού</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Skill_RhythmicAccuracyInSlurs</IRI>
        <Literal xml:lang="el">Δεξιότητα διατήρησης της προβλεπόμενης χρονικής διάρκειας και ρυθμικής ακρίβειας κατά την εκτέλεση δεμένων φθόγγων.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Skill_RhythmicAccuracyInSlurs</IRI>
        <Literal xml:lang="en">Rhythmic Accuracy in Slur Execution</Literal>
    </AnnotationAssertion>
