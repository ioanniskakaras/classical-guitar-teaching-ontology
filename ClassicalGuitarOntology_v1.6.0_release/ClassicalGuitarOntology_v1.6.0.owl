        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_1_1_2</IRI>
        <Literal xml:lang="el">Στόχος 1.1.2 – Ευχέρεια στους συνδυασμούς i–m, m–a και i–a του χεριού στην πλευρά του σώματος της κιθάρας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_1_1_3</IRI>
        <Literal xml:lang="el">Ευχέρεια στους συνδυασμούς 1–2, 1–3, 1–4, 2–3, 2–4 και 3–4 των δακτύλων του χεριού στην πλευρά του λαιμού της κιθάρας.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_1_1_3</IRI>
        <Literal xml:lang="en">Objective 1.1.3 – Fluency in the 1–2, 1–3, 1–4, 2–3, 2–4 and 3–4 combinations of the guitar-neck-side hand</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_1_1_3</IRI>
        <Literal xml:lang="el">Στόχος 1.1.3 – Ευχέρεια στους συνδυασμούς 1–2, 1–3, 1–4, 2–3, 2–4 και 3–4 του χεριού στην πλευρά του λαιμού της κιθάρας</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_1_1_4</IRI>
        <Literal xml:lang="el">Ανάγνωση, αναγνώριση στην ταστιέρα και εκτέλεση όλων των φυσικών φθόγγων της 1ης θέσης.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#LO_1_1_4</IRI>
        <Literal xml:lang="en">Objective 1.1.4 – Reading, fretboard recognition, and performance of all natural notes in first position</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="skos:prefLabel"/>
        <IRI>#LO_1_1_4</IRI>
        <Literal xml:lang="el">Στόχος 1.1.4 – Ανάγνωση, αναγνώριση στην ταστιέρα και εκτέλεση όλων των φυσικών φθόγγων της 1ης θέσης</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#LO_1_1_5</IRI>
        <Literal xml:lang="el">Χρήση του αντίχειρα (p) για συνοδεία με ανοικτά μπάσα και για εκτέλεση μελωδιών στις μπάσες χορδές.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
