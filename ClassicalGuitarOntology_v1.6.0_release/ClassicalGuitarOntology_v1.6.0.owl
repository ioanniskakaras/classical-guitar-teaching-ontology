        <IRI>#CreativityCategory_Level1</IRI>
        <Literal xml:lang="el">Κατηγορία δημιουργικότητας – 1ο Επίπεδο</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#CreativityObjectiveCategory</IRI>
        <Literal xml:lang="el">Κατηγορία μαθησιακών στόχων που αφορά την ανάπτυξη της δημιουργικότητας μέσω της σύνθεσης, του αυτοσχεδιασμού, της συνοδείας και άλλων μορφών δημιουργικής μουσικής δραστηριότητας με την κιθάρα.</Literal>
    </AnnotationAssertion>
