    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Crit_Level1_AnnualScalesArpeggiosChords</IRI>
        <Literal xml:lang="el">Αξιολογεί τη γνώση και την εκτέλεση των διδαχθεισών κλιμάκων, των αρπέζ των συγχορδιών και των συγχορδιών του 1ου επιπέδου.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#Crit_Level1_AnnualScalesArpeggiosChords</IRI>
        <Literal xml:lang="en">Level 1 Annual Examination Criterion: Scales, Chord Arpeggios, and Chords</Literal>
    </AnnotationAssertion>
