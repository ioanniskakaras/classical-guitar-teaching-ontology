        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#Leg</IRI>
        <Literal xml:lang="el">Αναπαριστά το μέρος του σώματος που συμβάλλει στη στήριξη και στη σταθερή τοποθέτηση της κλασικής κιθάρας κατά την καθιστή εκτέλεση.</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
